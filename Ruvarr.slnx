<Solution>
  <Folder Name="/Solution Items/">
    <File Path=".editorconfig" />
    <File Path=".github/workflows/dotnet.yml" />
    <File Path=".gitignore" />
    <File Path="Directory.Build.props" />
    <File Path="Directory.Packages.props" />
    <File Path="LICENSE" />
    <File Path="nuget.config" />
  </Folder>
  <Project Path="docker-compose.dcproj">
    <Build />
  </Project>
  <Folder Name="/src/">
    <Project Path="src/Ruvarr/Ruvarr.csproj" />
  </Folder>
  <Folder Name="/tests/">
    <File Path="tests/.editorconfig" />
<Project Path="tests/Ruvarr.IntegrationTests/Ruvarr.IntegrationTests.csproj" />
    <Project Path="tests/Ruvarr.Testing/Ruvarr.Testing.csproj" />
    <Project Path="tests/Ruvarr.UnitTests/Ruvarr.UnitTests.csproj" />
  </Folder>
</Solution>
