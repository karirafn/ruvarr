@page "/download-queue"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject RuvApiClient ApiClient
@using Ruvarr.Blazor.DownloadQueue
@implements IAsyncDisposable

<h1>Download Queue</h1>

@if (_items is null)
{
    <div class="spinner"></div>
}
else if (_items.Count == 0)
{
    <p>No pending downloads.</p>
}
else
{
    <table class="queue-table">
        <thead>
            <tr>
                <th>Program</th>
                <th>Episode</th>
                <th>Queued</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (DownloadQueueItemSummary item in _items)
            {
                <tr>
                    <td>@item.ProgramName</td>
                    <td>@item.EpisodeTitle</td>
                    <td>@item.Created.ToString("yyyy-MM-dd HH:mm")</td>
                    <td class="queue-status queue-status--@item.Status.ToString().ToLowerInvariant()">@item.Status</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<DownloadQueueItemSummary>? _items;
    private readonly CancellationTokenSource _cts = new();

    protected override Task OnInitializedAsync()
    {
        _ = WatchAsync();
        return Task.CompletedTask;
    }

    private async Task WatchAsync()
    {
        await foreach (List<DownloadQueueItemSummary> items in ApiClient.WatchDownloadQueueAsync(_cts.Token))
        {
            _items = items;
            await InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync()
    {
        await _cts.CancelAsync();
        _cts.Dispose();
    }
}
