@page "/download-queue"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@namespace Ruvarr.Downloads.Components
@using Ruvarr.Abstractions
@using Ruvarr.Contracts
@using Ruvarr.Downloads.Commands.DeleteDownloadQueueItem
@using Ruvarr.Downloads.Events
@using Ruvarr.Downloads.Queries.GetDownloadQueue
@inject IServiceScopeFactory ScopeFactory
@inject IDomainEventBroadcaster Broadcaster
@implements IAsyncDisposable

<h1>Download Queue</h1>

@if (_items is null)
{
    <div class="spinner"></div>
}
else if (_items.Count == 0)
{
    <p>No pending downloads.</p>
}
else
{
    <table class="queue-table">
        <thead>
            <tr>
                <th>Program</th>
                <th>Episode</th>
                <th>Queued</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (DownloadQueueItemSummary item in _items)
            {
                <tr>
                    <td>@item.ProgramName</td>
                    <td>@item.EpisodeTitle</td>
                    <td>@item.Created.ToString("yyyy-MM-dd HH:mm")</td>
                    <td class="queue-status queue-status--@item.Status.ToString().ToLowerInvariant()">
                        @switch (item.Status)
                        {
                            case DownloadQueueStatus.Pending:
                                <Icon Type="IconType.Clock" Class="icon" AriaLabel="Pending" />
                                break;
                            case DownloadQueueStatus.Downloading:
                                <Icon Type="IconType.Spinner" Class="icon icon--spinning" AriaLabel="Downloading" />
                                break;
                            case DownloadQueueStatus.Complete:
                                <Icon Type="IconType.Checkmark" Class="icon" AriaLabel="Complete" />
                                break;
                            case DownloadQueueStatus.Failed:
                                <Icon Type="IconType.Warning" Class="icon" AriaLabel="Failed" />
                                break;
                        }
                    </td>
                    <td>
                        @if (item.Status is DownloadQueueStatus.Pending or DownloadQueueStatus.Failed)
                        {
                            <button class="icon-button icon-button--danger"
                                    @onclick="() => DeleteAsync(item.EpisodeRuvId)"
                                    disabled="@_deleting.Contains(item.EpisodeRuvId)"
                                    title="Remove from queue">
                                <Icon Type="IconType.Trash" Class="icon" AriaLabel="Remove from queue" />
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<DownloadQueueItemSummary>? _items;
    private readonly HashSet<string> _deleting = [];
    private readonly CancellationTokenSource _cts = new();

    protected override Task OnInitializedAsync()
    {
        _ = WatchStartedAsync();
        _ = WatchCompletedAsync();
        _ = LoadAsync();
        return Task.CompletedTask;
    }

    [System.Diagnostics.CodeAnalysis.SuppressMessage("Minor Code Smell", "S1144", Justification = "Called from Razor template via @onclick")]
    private async Task DeleteAsync(string episodeRuvId)
    {
        _deleting.Add(episodeRuvId);

        await using AsyncServiceScope scope = ScopeFactory.CreateAsyncScope();
        IRequestHandler<DeleteDownloadQueueItemCommand> handler =
            scope.ServiceProvider.GetRequiredService<IRequestHandler<DeleteDownloadQueueItemCommand>>();
        await handler.Handle(new DeleteDownloadQueueItemCommand(episodeRuvId), _cts.Token);

        _deleting.Remove(episodeRuvId);
        _items = await QueryAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadAsync()
    {
        _items = await QueryAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task WatchStartedAsync()
    {
        await foreach (DownloadStartedEvent _ in Broadcaster.Subscribe<DownloadStartedEvent>(_cts.Token))
        {
            _items = await QueryAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task WatchCompletedAsync()
    {
        await foreach (DownloadCompletedEvent _ in Broadcaster.Subscribe<DownloadCompletedEvent>(_cts.Token))
        {
            _items = await QueryAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<List<DownloadQueueItemSummary>> QueryAsync()
    {
        await using AsyncServiceScope scope = ScopeFactory.CreateAsyncScope();
        IRequestHandler<GetDownloadQueueQuery, List<DownloadQueueItemSummary>> handler =
            scope.ServiceProvider.GetRequiredService<IRequestHandler<GetDownloadQueueQuery, List<DownloadQueueItemSummary>>>();
        return await handler.Handle(new GetDownloadQueueQuery(IncludeDownloaded: true), _cts.Token);
    }

    public async ValueTask DisposeAsync()
    {
        await _cts.CancelAsync();
        _cts.Dispose();
    }
}
