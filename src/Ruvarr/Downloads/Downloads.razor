@page "/downloads"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@namespace Ruvarr.Downloads
@implements IAsyncDisposable
@using Ruvarr.Abstractions
@using Ruvarr.Components
@using Ruvarr.Contracts
@using Ruvarr.Downloads.Commands.DismissDownloadQueueItem
@using Ruvarr.Downloads.Commands.RetryDownloadQueueItem
@using Ruvarr.Downloads.Domain
@using Ruvarr.Downloads.Events
@using Ruvarr.Downloads.Queries.GetDownloadQueue
@inject IServiceScopeFactory ScopeFactory
@inject IDomainEventBroadcaster Broadcaster

<h1 tabindex="-1" @ref="_heading">Downloads</h1>

<div class="downloads-action-feedback">
    <div class="queue-delete-error" role="alert">@(_feedback is ActionFeedback.Error error ? error.Message : null)</div>
    <p class="downloads-action-status" role="status">@if (_feedback is ActionFeedback.Dismissal dismissal){<text>Dismissed @dismissal.Subject. To download it again, open </text><a class="program-link" href="/program/@dismissal.ProgramRuvId">@dismissal.ProgramName</a><text>.</text>}</p>
</div>

@if (_items is null)
{
    <div class="spinner" role="status" aria-label="Loading"></div>
}
else if (_items.Count == 0)
{
    <p class="empty-message">No downloads in the queue.</p>
}
else
{
    <table class="queue-table downloads-table">
        <caption class="visually-hidden">Download queue, failed and exhausted items first</caption>
        <thead>
            <tr>
                <th scope="col">Program</th>
                <th scope="col">Episode</th>
                <th scope="col">Status</th>
                <th scope="col">Reason</th>
                <th scope="col">Retries</th>
                <th scope="col">Next retry</th>
                <th scope="col"><span class="visually-hidden">Actions</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (DownloadQueueItemSummary item in _items)
            {
                <tr @key="item.EpisodeRuvId">
                    <td>
                        <a class="program-link" href="/program/@item.ProgramRuvId">@item.ProgramName</a>
                    </td>
                    <td>@item.EpisodeTitle</td>
                    <td>
                        @switch (item.Status)
                        {
                            case DownloadQueueStatus.Failed:
                                <span class="status-pill status-pill--failed">
                                    <Icon Type="IconType.Warning" Class="icon" /> Failed
                                </span>
                                break;
                            case DownloadQueueStatus.Exhausted:
                                <span class="status-pill status-pill--exhausted">
                                    <Icon Type="IconType.Warning" Class="icon" /> Exhausted
                                </span>
                                break;
                            case DownloadQueueStatus.Downloading:
                                <span class="status-pill status-pill--downloading">
                                    <Icon Type="IconType.Spinner" Class="icon icon--spinning" /> Downloading
                                </span>
                                break;
                            case DownloadQueueStatus.Pending:
                                <span class="status-pill status-pill--pending">
                                    <Icon Type="IconType.Clock" Class="icon" /> Pending
                                </span>
                                break;
                            case DownloadQueueStatus.Complete:
                                <span class="status-pill status-pill--complete">
                                    <Icon Type="IconType.Checkmark" Class="icon" /> Complete
                                </span>
                                break;
                        }
                    </td>
                    <td class="downloads-reason">
                        @if (item.FailureReason is { } reason)
                        {
                            <span class="downloads-reason__text" tabindex="0" title="@reason">@reason</span>
                        }
                        else
                        {
                            <span class="unmatched-dash">—</span>
                        }
                    </td>
                    <td class="downloads-retries">
                        @if (item.Status is DownloadQueueStatus.Failed or DownloadQueueStatus.Exhausted)
                        {
                            <span class="downloads-retries__count">@item.RetryCount<span class="downloads-retries__cap">/@RetrySchedule.MaxRetries</span></span>
                        }
                        else
                        {
                            <span class="unmatched-dash">—</span>
                        }
                    </td>
                    <td class="downloads-next-retry">
                        @if (item.Status is DownloadQueueStatus.Exhausted)
                        {
                            <span class="unmatched-dash" title="Automatic retries exhausted — use Retry now">—</span>
                        }
                        else if (item.NextRetryAt is { } next)
                        {
                            <span title="@next.ToLocalTime().ToString("yyyy-MM-dd HH:mm")">@FormatRelative(next)</span>
                        }
                        else
                        {
                            <span class="unmatched-dash">—</span>
                        }
                    </td>
                    <td>
                        <div class="row-actions">
                            @if (item.HasRowActions)
                            {
                                bool busy = _inFlight.TryGetValue(item.EpisodeRuvId, out DownloadRowAction running);
                                bool retrying = busy && running == DownloadRowAction.Retry;
                                bool dismissing = busy && running == DownloadRowAction.Dismiss;
                                <button class="action-button downloads-retry-button"
                                        type="button"
                                        @ref="_retryButtons[item.EpisodeRuvId]"
                                        @onclick="() => RunAsync(item, DownloadRowAction.Retry)"
                                        disabled="@busy"
                                        aria-busy="@(retrying ? "true" : null)"
                                        aria-label="@BuildRetryLabel(item)">
                                    @if (retrying)
                                    {
                                        <span class="button-spinner" aria-hidden="true"></span><text> Retrying...</text>
                                    }
                                    else
                                    {
                                        <Icon Type="IconType.Refresh" Width="12" Height="12" /><text> Retry now</text>
                                    }
                                </button>
                                <button class="action-button downloads-dismiss-button"
                                        type="button"
                                        @ref="_dismissButtons[item.EpisodeRuvId]"
                                        @onclick="() => RunAsync(item, DownloadRowAction.Dismiss)"
                                        disabled="@busy"
                                        aria-busy="@(dismissing ? "true" : null)"
                                        aria-label="@BuildDismissLabel(item)">
                                    @if (dismissing)
                                    {
                                        <span class="button-spinner" aria-hidden="true"></span><text> Dismissing...</text>
                                    }
                                    else
                                    {
                                        <text>Dismiss</text>
                                    }
                                </button>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    // Closed set: the page shows nothing, an error, or a dismissal, never two at once.
    // A dismissal keeps the program details because its row is gone by the time it renders.
    private abstract record ActionFeedback
    {
        private ActionFeedback()
        {
        }

        public sealed record None : ActionFeedback;

        public sealed record Error(string Message) : ActionFeedback;

        public sealed record Dismissal(string Subject, string ProgramName, int ProgramRuvId) : ActionFeedback;
    }

    private IReadOnlyList<DownloadQueueItemSummary>? _items;
    private readonly Dictionary<string, DownloadRowAction> _inFlight = [];
    private readonly Dictionary<string, ElementReference> _retryButtons = [];
    private readonly Dictionary<string, ElementReference> _dismissButtons = [];
    private ElementReference _heading;
    private ActionFeedback _feedback = new ActionFeedback.None();
    private DownloadsFocusTarget? _pendingFocus;
    private readonly CancellationTokenSource _cts = new();

    protected override Task OnInitializedAsync()
    {
        _ = LoadAsync();
        _ = WatchAsync(Broadcaster.Subscribe<DownloadStartedEvent>(_cts.Token));
        _ = WatchAsync(Broadcaster.Subscribe<DownloadCompletedEvent>(_cts.Token));
        _ = WatchAsync(Broadcaster.Subscribe<DownloadFailedEvent>(_cts.Token));
        _ = WatchAsync(Broadcaster.Subscribe<DownloadRetryScheduledEvent>(_cts.Token));
        _ = WatchAsync(Broadcaster.Subscribe<DownloadDismissedEvent>(_cts.Token));
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingFocus is not { } target)
        {
            return;
        }

        _pendingFocus = null;
        await ResolveFocusTarget(target).FocusAsync();
    }

    private async Task LoadAsync()
    {
        _items = await QueryAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task WatchAsync<T>(IAsyncEnumerable<T> events) where T : class
    {
        await foreach (T _ in events)
        {
            _items = await QueryAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<IReadOnlyList<DownloadQueueItemSummary>> QueryAsync()
    {
        await using AsyncServiceScope scope = ScopeFactory.CreateAsyncScope();
        IRequestHandler<GetDownloadQueueQuery, IReadOnlyList<DownloadQueueItemSummary>> handler =
            scope.ServiceProvider.GetRequiredService<IRequestHandler<GetDownloadQueueQuery, IReadOnlyList<DownloadQueueItemSummary>>>();
        return await handler.Handle(new GetDownloadQueueQuery(), _cts.Token);
    }

    [System.Diagnostics.CodeAnalysis.SuppressMessage("Minor Code Smell", "S1144", Justification = "Called from Razor template via @onclick")]
    private async Task RunAsync(DownloadQueueItemSummary item, DownloadRowAction action)
    {
        int index = IndexOf(item.EpisodeRuvId);
        _inFlight[item.EpisodeRuvId] = action;
        _feedback = new ActionFeedback.None();

        RuvarrResult result;
        try
        {
            result = await SendAsync(item.EpisodeRuvId, action);
        }
        finally
        {
            _inFlight.Remove(item.EpisodeRuvId);
        }

        _feedback = result switch
        {
            { IsFailure: true } => new ActionFeedback.Error(result.Error.Description),
            _ when action is DownloadRowAction.Dismiss => new ActionFeedback.Dismissal(DescribeEpisode(item), item.ProgramName, item.ProgramRuvId),
            _ => new ActionFeedback.None(),
        };

        _items = await QueryAsync();
        _pendingFocus = DownloadsFocusTarget.AfterAction(_items, item.EpisodeRuvId, action, index);
        await InvokeAsync(StateHasChanged);
    }

    private async Task<RuvarrResult> SendAsync(string episodeRuvId, DownloadRowAction action)
    {
        await using AsyncServiceScope scope = ScopeFactory.CreateAsyncScope();
        return action switch
        {
            DownloadRowAction.Retry => await scope.ServiceProvider
                .GetRequiredService<IRequestHandler<RetryDownloadQueueItemCommand>>()
                .Handle(new RetryDownloadQueueItemCommand(episodeRuvId), _cts.Token),
            _ => await scope.ServiceProvider
                .GetRequiredService<IRequestHandler<DismissDownloadQueueItemCommand>>()
                .Handle(new DismissDownloadQueueItemCommand(episodeRuvId), _cts.Token),
        };
    }

    private ElementReference ResolveFocusTarget(DownloadsFocusTarget target)
    {
        if (target is DownloadsFocusTarget.RowButton row
            && _items is { } items
            && items.Any(x => x.EpisodeRuvId == row.EpisodeRuvId && x.HasRowActions)
            && (row.Button is DownloadRowAction.Retry ? _retryButtons : _dismissButtons).TryGetValue(row.EpisodeRuvId, out ElementReference button))
        {
            return button;
        }

        return _heading;
    }

    private int IndexOf(string episodeRuvId)
    {
        IReadOnlyList<DownloadQueueItemSummary> items = _items ?? [];
        for (int i = 0; i < items.Count; i++)
        {
            if (items[i].EpisodeRuvId == episodeRuvId)
            {
                return i;
            }
        }

        return items.Count;
    }

    private static string DescribeEpisode(DownloadQueueItemSummary item) =>
        string.IsNullOrWhiteSpace(item.EpisodeTitle)
            ? $"episode from {item.ProgramName}"
            : item.EpisodeTitle;

    private static string BuildRetryLabel(DownloadQueueItemSummary item) =>
        $"Retry download of {DescribeEpisode(item)} now";

    private static string BuildDismissLabel(DownloadQueueItemSummary item) =>
        $"Dismiss {DescribeEpisode(item)} from the download queue";

    private static string FormatRelative(DateTime nextUtc)
    {
        TimeSpan remaining = nextUtc - DateTime.UtcNow;
        if (remaining <= TimeSpan.Zero)
        {
            return "due now";
        }

        if (remaining.TotalHours < 1)
        {
            return $"in ~{Math.Max(1, (int)remaining.TotalMinutes)}m";
        }

        if (remaining.TotalHours < 24)
        {
            return $"in ~{(int)remaining.TotalHours}h";
        }

        return $"in ~{(int)remaining.TotalDays}d";
    }

    public async ValueTask DisposeAsync()
    {
        await _cts.CancelAsync();
        _cts.Dispose();
    }
}
