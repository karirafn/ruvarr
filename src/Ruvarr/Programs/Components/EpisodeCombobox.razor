@namespace Ruvarr.Programs.Components
@using Ruvarr.Contracts
@implements IAsyncDisposable
@inject IJSRuntime Js

<div class="episode-combobox">
    <label id="@_labelId" for="@_inputId" class="episode-combobox-label">Episode</label>
    <div class="episode-combobox-control">
        <input @ref="_inputRef"
               id="@_inputId"
               class="episode-combobox-input"
               role="combobox"
               aria-autocomplete="list"
               aria-haspopup="listbox"
               aria-expanded="@_isPopupOpen.ToString().ToLowerInvariant()"
               aria-controls="@_listboxId"
               aria-labelledby="@_labelId"
               @attributes="ActiveDescendantAttribute"
               autocomplete="off"
               value="@_query"
               @oninput="OnInputAsync"
               @onblur="OnBlurAsync"
               @onclick="OnClickInputAsync"
               @onkeydown="OnKeyDownAsync" />
        <button class="episode-combobox-chevron"
                type="button"
                aria-label="Show episodes"
                tabindex="-1"
                @onmousedown:preventDefault
                @onclick="OnChevronClickAsync">
            <svg width="10" height="6" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M1 1l4 4 4-4" stroke="rgba(255,255,255,0.4)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </button>
    </div>

    <ul id="@_listboxId"
        class="episode-combobox-popup"
        role="listbox"
        aria-labelledby="@_labelId"
        hidden="@(!_isPopupOpen)">
        @if (_isPopupOpen)
        {
            @if (_filteredEpisodes.Count == 0)
            {
                <li class="episode-combobox-empty" role="presentation">No episodes match &quot;@_query&quot;</li>
            }
            else
            {
                @foreach (TvdbSeriesEpisode episode in _filteredEpisodes)
                {
                    string optionId = OptionId(episode.TvdbId);
                    bool isHighlighted = episode.TvdbId == _highlightedId;
                    bool isSelected = episode.TvdbId == SelectedEpisodeId;
                    string cssClass = BuildOptionCssClass(isHighlighted, isSelected);
                    int capturedTvdbId = episode.TvdbId;
                    <li @key="episode.TvdbId"
                        id="@optionId"
                        class="@cssClass"
                        role="option"
                        aria-selected="@isSelected.ToString().ToLowerInvariant()"
                        @onmousedown:preventDefault
                        @onmousedown="() => CommitOptionAsync(capturedTvdbId)">
                        @BuildLabel(episode)
                    </li>
                }
                @if (_totalCount > MaxResults)
                {
                    <li class="episode-combobox-cap" role="presentation">
                        Showing @MaxResults of @_totalCount matches &mdash; keep typing to narrow
                    </li>
                }
            }
        }
    </ul>

    <div aria-live="polite" aria-atomic="true" class="visually-hidden">@_liveText</div>
</div>

@code {
    public const int MaxResults = 100;

    [Parameter, EditorRequired]
    public IReadOnlyList<TvdbSeriesEpisode> Episodes { get; set; } = [];

    [Parameter]
    public int? SelectedEpisodeId { get; set; }

    [Parameter]
    public EventCallback<int?> SelectedEpisodeIdChanged { get; set; }

    [Parameter]
    public int? DefaultSeason { get; set; }

    [Parameter]
    public EventCallback OnSubmitRequested { get; set; }

    private readonly string _id = $"episode-combobox-{Guid.NewGuid():N}";

    // _labelId, _inputId, _listboxId are computed once from _id in the constructor so they
    // are readonly fields rather than expression-bodied properties that allocate on every render.
    private readonly string _labelId;
    private readonly string _inputId;
    private readonly string _listboxId;

    public EpisodeCombobox()
    {
        _labelId = $"{_id}-label";
        _inputId = $"{_id}-input";
        _listboxId = $"{_id}-listbox";
    }

    private string _query = string.Empty;
    private bool _isPopupOpen;
    private int? _highlightedId;
    private ElementReference _inputRef;

    private IReadOnlyList<TvdbSeriesEpisode> _filteredEpisodes = [];
    private int _totalCount;
    private string _liveText = string.Empty;

    private Dictionary<string, object> ActiveDescendantAttribute =>
        _isPopupOpen && _highlightedId is not null
            ? new Dictionary<string, object> { ["aria-activedescendant"] = OptionId(_highlightedId.Value) }
            : [];

    private string OptionId(int tvdbId) => $"{_id}-opt-{tvdbId}";

    public async ValueTask FocusAndSelectAsync()
    {
        await Js.InvokeVoidAsync("selectElementText", _inputRef);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("unregisterComboboxKeys", _inputRef);
        }
        catch (JSDisconnectedException)
        {
            // Expected when the circuit is disconnected during disposal
        }
        catch (ObjectDisposedException)
        {
            // Expected when the JS runtime is disposed during disposal
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Js.InvokeVoidAsync("registerComboboxKeys", _inputRef);
        }
    }

    protected override void OnParametersSet()
    {
        if (_isPopupOpen)
        {
            return;
        }

        _query = SelectedEpisodeId is not null
            ? FindSelectedLabel()
            : string.Empty;
    }

    private string FindSelectedLabel()
    {
        if (SelectedEpisodeId is null)
        {
            return string.Empty;
        }

        TvdbSeriesEpisode? episode = Episodes.FirstOrDefault(e => e.TvdbId == SelectedEpisodeId);
        return episode is not null ? BuildLabel(episode) : string.Empty;
    }

    private void RecomputeFiltered()
    {
        IReadOnlyList<TvdbSeriesEpisode> all = FilterAndOrder(Episodes, _query, SelectedEpisodeId, DefaultSeason);
        _totalCount = all.Count;
        _filteredEpisodes = _totalCount > MaxResults ? [.. all.Take(MaxResults)] : all;
        _liveText = BuildLiveText();
    }

    private static string BuildOptionCssClass(bool isHighlighted, bool isSelected)
    {
        return (isHighlighted, isSelected) switch
        {
            (true, true) => "episode-combobox-option is-highlighted is-selected",
            (true, false) => "episode-combobox-option is-highlighted",
            (false, true) => "episode-combobox-option is-selected",
            _ => "episode-combobox-option",
        };
    }

    private string BuildLiveText()
    {
        if (_filteredEpisodes.Count == 0)
        {
            return $"No episodes match \"{_query}\"";
        }

        if (_totalCount > MaxResults)
        {
            return $"Showing {MaxResults} of {_totalCount} matches — keep typing to narrow";
        }

        return $"{_filteredEpisodes.Count} episodes";
    }

    private int NextIndexGoingUp(int currentIndex)
    {
        return currentIndex <= 0 ? _filteredEpisodes.Count - 1 : currentIndex - 1;
    }

    private async Task OnClickInputAsync()
    {
        if (!_isPopupOpen)
        {
            RecomputeFiltered();
            HighlightSelected();
            _isPopupOpen = true;
            await ScrollToHighlightedAsync();
        }
    }

    private async Task OnInputAsync(ChangeEventArgs e)
    {
        _query = e.Value?.ToString() ?? string.Empty;
        RecomputeFiltered();
        _highlightedId = _filteredEpisodes.Count > 0 ? _filteredEpisodes[0].TvdbId : null;
        _isPopupOpen = true;
        await ScrollToHighlightedAsync();
    }

    private Task OnBlurAsync()
    {
        _isPopupOpen = false;
        _highlightedId = null;
        _query = FindSelectedLabel();
        return Task.CompletedTask;
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowDown":
                await HandleArrowDownAsync();
                break;
            case "ArrowUp":
                await HandleArrowUpAsync();
                break;
            case "Enter":
                await HandleEnterAsync();
                break;
            case "Escape":
                HandleEscape();
                break;
        }
    }

    private async Task HandleArrowDownAsync()
    {
        if (!_isPopupOpen)
        {
            RecomputeFiltered();
            _highlightedId = _filteredEpisodes.Count > 0 ? _filteredEpisodes[0].TvdbId : null;
            _isPopupOpen = true;
        }
        else
        {
            MoveHighlight(1);
        }

        await ScrollToHighlightedAsync();
    }

    private async Task HandleArrowUpAsync()
    {
        if (!_isPopupOpen)
        {
            RecomputeFiltered();
            _highlightedId = _filteredEpisodes.Count > 0 ? _filteredEpisodes[^1].TvdbId : null;
            _isPopupOpen = true;
        }
        else
        {
            MoveHighlight(-1);
        }

        await ScrollToHighlightedAsync();
    }

    private void MoveHighlight(int direction)
    {
        if (_filteredEpisodes.Count == 0)
        {
            return;
        }

        int currentIndex = -1;
        if (_highlightedId is not null)
        {
            for (int i = 0; i < _filteredEpisodes.Count; i++)
            {
                if (_filteredEpisodes[i].TvdbId == _highlightedId)
                {
                    currentIndex = i;
                    break;
                }
            }
        }

        int nextIndex = direction > 0
            ? (currentIndex + 1) % _filteredEpisodes.Count
            : NextIndexGoingUp(currentIndex);

        _highlightedId = _filteredEpisodes[nextIndex].TvdbId;
    }

    private async Task HandleEnterAsync()
    {
        if (_isPopupOpen)
        {
            if (_highlightedId is not null)
            {
                await CommitOptionAsync(_highlightedId.Value);
            }
            else
            {
                _isPopupOpen = false;
            }
        }
        else
        {
            await OnSubmitRequested.InvokeAsync();
        }
    }

    private void HandleEscape()
    {
        if (_isPopupOpen)
        {
            _isPopupOpen = false;
            _highlightedId = null;
            _query = FindSelectedLabel();
        }
    }

    private async Task CommitOptionAsync(int tvdbId)
    {
        TvdbSeriesEpisode? episode = Episodes.FirstOrDefault(e => e.TvdbId == tvdbId);
        if (episode is null)
        {
            return;
        }

        _query = BuildLabel(episode);
        _isPopupOpen = false;
        _highlightedId = null;

        await SelectedEpisodeIdChanged.InvokeAsync(tvdbId);
    }

    private async Task OnChevronClickAsync()
    {
        if (_isPopupOpen)
        {
            _isPopupOpen = false;
            _highlightedId = null;
        }
        else
        {
            RecomputeFiltered();
            HighlightSelected();
            _isPopupOpen = true;
            await ScrollToHighlightedAsync();
        }

        await Js.InvokeVoidAsync("focusElement", _inputRef);
    }

    private void HighlightSelected()
    {
        if (SelectedEpisodeId is not null && _filteredEpisodes.Any(e => e.TvdbId == SelectedEpisodeId))
        {
            _highlightedId = SelectedEpisodeId;
        }
        else
        {
            _highlightedId = null;
        }
    }

    private async Task ScrollToHighlightedAsync()
    {
        if (_highlightedId is not null)
        {
            await Js.InvokeVoidAsync("scrollOptionIntoView", OptionId(_highlightedId.Value));
        }
    }

    internal static string BuildLabel(TvdbSeriesEpisode episode)
    {
        string sxxExx = $"S{episode.SeasonNumber:D2}E{episode.EpisodeNumber:D2}";

        return string.IsNullOrWhiteSpace(episode.Name)
            ? sxxExx
            : $"{sxxExx} · {episode.Name}";
    }

    internal static bool Matches(TvdbSeriesEpisode episode, string query)
    {
        return BuildLabel(episode).Contains(query, StringComparison.OrdinalIgnoreCase);
    }

    internal static IReadOnlyList<TvdbSeriesEpisode> FilterAndOrder(
        IReadOnlyList<TvdbSeriesEpisode> episodes,
        string query,
        int? selectedEpisodeId,
        int? defaultSeason)
    {
        IEnumerable<TvdbSeriesEpisode> filtered;

        if (string.IsNullOrWhiteSpace(query))
        {
            if (selectedEpisodeId is not null)
            {
                TvdbSeriesEpisode? selected = episodes.FirstOrDefault(e => e.TvdbId == selectedEpisodeId);
                int? selectedSeason = selected?.SeasonNumber;
                filtered = selectedSeason is not null
                    ? episodes.Where(e => e.SeasonNumber == selectedSeason)
                    : [];
            }
            else
            {
                filtered = defaultSeason is not null
                    ? episodes.Where(e => e.SeasonNumber == defaultSeason)
                    : [];
            }
        }
        else
        {
            filtered = episodes.Where(e => Matches(e, query));
        }

        return [.. filtered
            .OrderBy(e => e.SeasonNumber)
            .ThenBy(e => e.EpisodeNumber)];
    }
}
