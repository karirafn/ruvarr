@namespace Ruvarr.Programs.Components
@using Ruvarr.Abstractions
@using Ruvarr.Contracts
@using System.Globalization
@using Ruvarr.Programs.Commands.MatchEpisode
@using Ruvarr.Programs.Queries.GetEpisodeMatchSuggestion
@using Ruvarr.Programs.Queries.GetTvdbSeriesEpisodes
@implements IAsyncDisposable
@inject IServiceScopeFactory ScopeFactory
@inject IJSRuntime Js

<dialog @ref="_dialog" @onclose="OnDialogClose" aria-labelledby="match-episode-dialog-title">
    <h2 id="match-episode-dialog-title">Match to TVDB</h2>
    @if (_isLoading)
    {
        <div class="dialog-spinner-container" role="status" aria-label="Loading episodes">
            <span class="dialog-spinner"></span>
        </div>
    }
    else if (_errorMessage is not null)
    {
        <p class="dialog-error">@_errorMessage</p>
    }
    else if (_allEpisodes.Count == 0)
    {
        <p class="dialog-error">No episodes found for this series.</p>
    }
    else
    {
        @for (int i = 0; i < _matchEntries.Count; i++)
        {
            int index = i;
            MatchEntry entry = _matchEntries[index];
            TvdbSeriesEpisode? suggested = index == 0 ? ShownSuggestedEpisode() : null;
            <fieldset class="match-entry">
                <legend class="visually-hidden">Match @(index + 1)</legend>
                <EpisodeCombobox
                    Episodes="_allEpisodes"
                    @bind-SelectedEpisodeId="entry.SelectedEpisodeId"
                    DefaultSeason="_defaultSeason"
                    OnSubmitRequested="HandleSubmitRequested"
                    AriaDescribedBy="@(suggested is null ? null : SuggestionNoteId)"
                    @ref="entry.ComboboxRef" />
                @if (suggested is not null && _suggestion is not null)
                {
                    @if (_suggestion.Reason == MatchSuggestionReason.OutsideDeclaredSeason)
                    {
                        <p id="@SuggestionNoteId" class="caution-strip match-suggestion-note">
                            <Icon Type="IconType.Warning" Class="icon caution-strip__icon" />
                            <span class="caution-strip__text"><span class="visually-hidden">Caution: </span>Title matches @SeasonEpisodeCode(suggested), outside this program's @FormatDeclaredSeasons(_declaredSeasons). Check before matching.</span>
                        </p>
                    }
                    else
                    {
                        <p id="@SuggestionNoteId" class="match-suggestion-note match-suggestion-note--neutral">Suggested from the title &quot;@_episodeTitle&quot;: @SeasonEpisodeCode(suggested).</p>
                    }
                }
                @if (_matchEntries.Count > 1)
                {
                    <button class="match-entry-remove" type="button" @onclick="() => RemoveEntry(index)" aria-label="Remove match @(index + 1)">Remove</button>
                }
            </fieldset>
        }
        <button class="match-add-button" type="button" @ref="_addButton" @onclick="AddEntry">+ Add another match</button>
    }
    <div class="dialog-actions">
        @if (!_isLoading)
        {
            <button class="dialog-button dialog-button--primary" @onclick="SubmitMatch" disabled="@IsMatchDisabled(_matchEntries, _currentMatches, _isSubmitting)">
                @if (_isSubmitting)
                {
                    <span class="button-spinner"></span>
                }
                Match
            </button>
        }
        <button class="dialog-button" @onclick="CloseAsync" disabled="@_isSubmitting">Cancel</button>
    </div>
</dialog>

@code {
    [Parameter]
    public EventCallback OnMatchComplete { get; set; }

    private ElementReference _dialog;
    private ElementReference _addButton;
    private string? _ruvId;
    private List<TvdbEpisodeSummary> _currentMatches = [];
    private bool _isLoading;
    private bool _isSubmitting;
    private string? _errorMessage;
    private readonly CancellationTokenSource _cts = new();

    private IReadOnlyList<TvdbSeriesEpisode> _allEpisodes = [];
    private List<MatchEntry> _matchEntries = [];
    private int _tvdbSeriesId;
    private string _episodeTitle = string.Empty;
    private int? _defaultSeason;
    private SuggestedEpisode? _suggestion;
    private IReadOnlyList<int> _declaredSeasons = [];

    private const string SuggestionNoteId = "match-suggestion-note";

    public async Task OpenAsync(string ruvId, IReadOnlyList<TvdbEpisodeSummary> currentMatches, int tvdbSeriesId, string episodeTitle)
    {
        _ruvId = ruvId;
        _currentMatches = [.. currentMatches];
        _tvdbSeriesId = tvdbSeriesId;
        _episodeTitle = episodeTitle;
        _isLoading = true;
        _errorMessage = null;
        _allEpisodes = [];
        _matchEntries = [new MatchEntry()];
        _suggestion = null;
        _declaredSeasons = [];

        await InvokeAsync(StateHasChanged);
        await Js.InvokeVoidAsync("showDialog", _dialog);

        await LoadEpisodesAsync(ruvId);
    }

    private async Task LoadEpisodesAsync(string ruvId)
    {
        try
        {
            await using AsyncServiceScope scope = ScopeFactory.CreateAsyncScope();
            IRequestHandler<GetTvdbSeriesEpisodesQuery, IReadOnlyList<TvdbSeriesEpisode>> handler =
                scope.ServiceProvider.GetRequiredService<IRequestHandler<GetTvdbSeriesEpisodesQuery, IReadOnlyList<TvdbSeriesEpisode>>>();
            Task<IReadOnlyList<TvdbSeriesEpisode>> episodesTask = handler.Handle(new GetTvdbSeriesEpisodesQuery(_tvdbSeriesId), _cts.Token);

            if (_currentMatches.Count > 0)
            {
                _allEpisodes = await episodesTask;
                _defaultSeason = _currentMatches.Min(m => m.SeasonNumber);
                _matchEntries = [.. _currentMatches.Select(m => new MatchEntry { SelectedEpisodeId = m.TvdbId })];
            }
            else
            {
                Task<EpisodeMatchSuggestion?> suggestionTask = GetSuggestionAsync(scope.ServiceProvider, ruvId);
                await Task.WhenAll(episodesTask, suggestionTask);
                _allEpisodes = await episodesTask;
                ApplySuggestion(await suggestionTask);
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _errorMessage = "Failed to load episodes. Please try again.";
        }
        finally
        {
            _isLoading = false;
            await InvokeAsync(StateHasChanged);
        }

        if (_errorMessage is null && _matchEntries.Count > 0)
        {
            await Task.Yield();
            await FocusFirstEntryAsync();
        }
    }

    private async Task FocusFirstEntryAsync()
    {
        if (_matchEntries.Count > 0 && _matchEntries[0].ComboboxRef is EpisodeCombobox combobox)
        {
            await combobox.FocusAndSelectAsync();
        }
    }

    private async Task<EpisodeMatchSuggestion?> GetSuggestionAsync(IServiceProvider services, string ruvId)
    {
        try
        {
            IRequestHandler<GetEpisodeMatchSuggestionQuery, EpisodeMatchSuggestion?> handler =
                services.GetRequiredService<IRequestHandler<GetEpisodeMatchSuggestionQuery, EpisodeMatchSuggestion?>>();
            return await handler.Handle(new GetEpisodeMatchSuggestionQuery(ruvId), _cts.Token);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // A suggestion is a convenience: without one the dialog works as an unsuggested manual match.
            return null;
        }
    }

    private void ApplySuggestion(EpisodeMatchSuggestion? response)
    {
        _defaultSeason = response?.DefaultSeason ?? _allEpisodes.Select(e => (int?)e.SeasonNumber).Min();
        _declaredSeasons = response?.DeclaredSeasons ?? [];

        if (response?.Suggestion is SuggestedEpisode suggestion && _allEpisodes.Any(e => e.TvdbId == suggestion.TvdbId))
        {
            _suggestion = suggestion;
            _matchEntries[0].SelectedEpisodeId = suggestion.TvdbId;
        }
    }

    /// <summary>The suggested episode while entry 0 still holds it; the note hides once the user picks another.</summary>
    private TvdbSeriesEpisode? ShownSuggestedEpisode() =>
        _suggestion is not null && _matchEntries.Count > 0 && _matchEntries[0].SelectedEpisodeId == _suggestion.TvdbId
            ? _allEpisodes.FirstOrDefault(e => e.TvdbId == _suggestion.TvdbId)
            : null;

    private static string SeasonEpisodeCode(TvdbSeriesEpisode episode) =>
        string.Create(CultureInfo.InvariantCulture, $"S{episode.SeasonNumber:D2}E{episode.EpisodeNumber:D2}");

    private static string FormatDeclaredSeasons(IReadOnlyList<int> declaredSeasons) =>
        declaredSeasons.Count == 1
            ? string.Create(CultureInfo.InvariantCulture, $"season {declaredSeasons[0]}")
            : "seasons " + string.Join(", ", declaredSeasons.Select(s => s.ToString(CultureInfo.InvariantCulture)));

    [System.Diagnostics.CodeAnalysis.SuppressMessage("Minor Code Smell", "S1144", Justification = "Called from Razor template via @onclick")]
    private void AddEntry()
    {
        MatchEntry? lastEntry = _matchEntries.Count > 0 ? _matchEntries[^1] : null;
        MatchEntry entry = new();
        if (lastEntry?.SelectedEpisodeId is not null)
        {
            entry.SelectedEpisodeId = GetNextEpisodeId([.. _allEpisodes], lastEntry.SelectedEpisodeId);
        }
        _matchEntries.Add(entry);
    }

    [System.Diagnostics.CodeAnalysis.SuppressMessage("Minor Code Smell", "S1144", Justification = "Called from Razor template via @onclick")]
    private async Task RemoveEntry(int index)
    {
        _matchEntries.RemoveAt(index);

        if (_matchEntries.Count == 0)
        {
            return;
        }

        await Task.Yield();

        if (_matchEntries.Count == 1)
        {
            await Js.InvokeVoidAsync("focusElement", _addButton);
        }
        else
        {
            int focusIndex = index > 0 ? index - 1 : 0;
            EpisodeCombobox? combobox = _matchEntries[focusIndex].ComboboxRef;
            if (combobox is not null)
            {
                await combobox.FocusAndSelectAsync();
            }
        }
    }

    internal static int? GetNextEpisodeId(IReadOnlyList<TvdbSeriesEpisode> episodes, int? currentEpisodeId)
    {
        if (currentEpisodeId is null)
        {
            return null;
        }

        int currentIndex = -1;
        for (int i = 0; i < episodes.Count; i++)
        {
            if (episodes[i].TvdbId == currentEpisodeId)
            {
                currentIndex = i;
                break;
            }
        }

        if (currentIndex < 0 || currentIndex >= episodes.Count - 1)
        {
            return null;
        }

        return episodes[currentIndex + 1].TvdbId;
    }

    [System.Diagnostics.CodeAnalysis.SuppressMessage("Minor Code Smell", "S1144", Justification = "Called from Razor template via @onclick")]
    private async Task CloseAsync()
    {
        await Js.InvokeVoidAsync("closeDialog", _dialog);
    }

    private void OnDialogClose()
    {
        _ruvId = null;
        _currentMatches = [];
        _allEpisodes = [];
        _matchEntries = [];
        _errorMessage = null;
        _episodeTitle = string.Empty;
        _suggestion = null;
        _declaredSeasons = [];
        _defaultSeason = null;
    }

    [System.Diagnostics.CodeAnalysis.SuppressMessage("Minor Code Smell", "S1144", Justification = "Called from Razor template via @onclick")]
    private async Task SubmitMatch()
    {
        if (_isSubmitting)
        {
            return;
        }

        _isSubmitting = true;

        List<int> tvdbIds = [.. _matchEntries
            .Select(e => e.SelectedEpisodeId)
            .OfType<int>()];

        if (_ruvId is null || tvdbIds.Count == 0)
        {
            _isSubmitting = false;
            return;
        }

        try
        {
            await using AsyncServiceScope scope = ScopeFactory.CreateAsyncScope();
            IRequestHandler<MatchEpisodeCommand> handler =
                scope.ServiceProvider.GetRequiredService<IRequestHandler<MatchEpisodeCommand>>();
            await handler.Handle(new MatchEpisodeCommand(_ruvId, tvdbIds), _cts.Token);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _errorMessage = "Failed to match episode. Please try again.";
            _isSubmitting = false;
            return;
        }

        _isSubmitting = false;
        await CloseAsync();
        await OnMatchComplete.InvokeAsync();
    }

    private async Task HandleSubmitRequested()
    {
        if (!IsMatchDisabled(_matchEntries, _currentMatches, _isSubmitting))
        {
            await SubmitMatch();
        }
    }

    public async ValueTask DisposeAsync()
    {
        await _cts.CancelAsync();
        _cts.Dispose();
    }

    internal static bool IsMatchDisabled(IReadOnlyList<MatchEntry> entries, IReadOnlyList<TvdbEpisodeSummary> currentMatches, bool isSubmitting)
    {
        if (isSubmitting)
        {
            return true;
        }

        if (entries.Count == 0)
        {
            return true;
        }

        if (entries.Any(e => e.SelectedEpisodeId is null))
        {
            return true;
        }

        int distinctCount = entries
            .Select(e => e.SelectedEpisodeId)
            .Distinct()
            .Count();

        if (distinctCount != entries.Count)
        {
            return true;
        }

        List<int> selectedIds = [.. entries
            .Select(e => e.SelectedEpisodeId)
            .OfType<int>()
            .Order()];

        List<int> currentIds = [.. currentMatches
            .Select(m => m.TvdbId)
            .Order()];

        return selectedIds.SequenceEqual(currentIds);
    }

    internal sealed class MatchEntry
    {
        public int? SelectedEpisodeId { get; set; }
        public EpisodeCombobox? ComboboxRef { get; set; }
    }
}
