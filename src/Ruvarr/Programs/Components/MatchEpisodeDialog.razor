@namespace Ruvarr.Programs.Components
@using Ruvarr.Abstractions
@using Ruvarr.Contracts
@using Ruvarr.Programs.Commands.MatchEpisode
@using Ruvarr.Programs.Queries.GetTvdbSeriesEpisodes
@implements IAsyncDisposable
@inject IServiceScopeFactory ScopeFactory
@inject IJSRuntime Js

<dialog @ref="_dialog" @onclose="OnDialogClose">
    <h2>Match to TVDB</h2>
    @if (_isLoading)
    {
        <div class="dialog-spinner-container" role="status" aria-label="Loading episodes">
            <span class="dialog-spinner"></span>
        </div>
    }
    else if (_errorMessage is not null)
    {
        <p class="dialog-error">@_errorMessage</p>
    }
    else if (_allEpisodes.Count == 0)
    {
        <p class="dialog-error">No episodes found for this series.</p>
    }
    else
    {
        @for (int i = 0; i < _matchEntries.Count; i++)
        {
            int index = i;
            MatchEntry entry = _matchEntries[index];
            <fieldset class="match-entry">
                <legend class="visually-hidden">Match @(index + 1)</legend>
                <EpisodeCombobox
                    Episodes="_allEpisodes"
                    @bind-SelectedEpisodeId="entry.SelectedEpisodeId"
                    DefaultSeason="ResolveDefaultSeason(_siblingEpisodes, [.. _allEpisodes.Select(e => e.SeasonNumber).Distinct().OrderBy(s => s)])"
                    OnSubmitRequested="HandleSubmitRequested"
                    @ref="entry.ComboboxRef" />
                @if (_matchEntries.Count > 1)
                {
                    <button class="match-entry-remove" type="button" @onclick="() => RemoveEntry(index)" aria-label="Remove match @(index + 1)">Remove</button>
                }
            </fieldset>
        }
        <button class="match-add-button" type="button" @ref="_addButton" @onclick="AddEntry">+ Add another match</button>
    }
    <div class="dialog-actions">
        @if (!_isLoading)
        {
            <button class="dialog-button dialog-button--primary" @onclick="SubmitMatch" disabled="@IsMatchDisabled(_matchEntries, _currentMatches, _isSubmitting)">
                @if (_isSubmitting)
                {
                    <span class="button-spinner"></span>
                }
                Match
            </button>
        }
        <button class="dialog-button" @onclick="CloseAsync" disabled="@_isSubmitting">Cancel</button>
    </div>
</dialog>

@code {
    [Parameter]
    public EventCallback OnMatchComplete { get; set; }

    private ElementReference _dialog;
    private ElementReference _addButton;
    private string? _ruvId;
    private List<TvdbEpisodeSummary> _currentMatches = [];
    private bool _isLoading;
    private bool _isSubmitting;
    private string? _errorMessage;
    private readonly CancellationTokenSource _cts = new();

    private IReadOnlyList<TvdbSeriesEpisode> _allEpisodes = [];
    private List<MatchEntry> _matchEntries = [];
    private int _tvdbSeriesId;
    private string _episodeTitle = string.Empty;
    private List<EpisodeSummary> _siblingEpisodes = [];

    public async Task OpenAsync(string ruvId, IReadOnlyList<TvdbEpisodeSummary> currentMatches, int tvdbSeriesId, string episodeTitle, List<EpisodeSummary> siblingEpisodes)
    {
        _ruvId = ruvId;
        _currentMatches = [.. currentMatches];
        _tvdbSeriesId = tvdbSeriesId;
        _episodeTitle = episodeTitle;
        _siblingEpisodes = siblingEpisodes;
        _isLoading = true;
        _errorMessage = null;
        _allEpisodes = [];
        _matchEntries = [new MatchEntry()];

        await InvokeAsync(StateHasChanged);
        await Js.InvokeVoidAsync("showDialog", _dialog);

        await LoadEpisodesAsync();
    }

    private async Task LoadEpisodesAsync()
    {
        try
        {
            await using AsyncServiceScope scope = ScopeFactory.CreateAsyncScope();
            IRequestHandler<GetTvdbSeriesEpisodesQuery, IReadOnlyList<TvdbSeriesEpisode>> handler =
                scope.ServiceProvider.GetRequiredService<IRequestHandler<GetTvdbSeriesEpisodesQuery, IReadOnlyList<TvdbSeriesEpisode>>>();
            _allEpisodes = await handler.Handle(new GetTvdbSeriesEpisodesQuery(_tvdbSeriesId), _cts.Token);

            if (_currentMatches.Count > 0)
            {
                _matchEntries.Clear();
                foreach (TvdbEpisodeSummary match in _currentMatches)
                {
                    MatchEntry entry = new()
                    {
                        SelectedEpisodeId = match.TvdbId,
                    };
                    _matchEntries.Add(entry);
                }
            }
            else
            {
                TryAutoSelectEpisode(_matchEntries[0]);
            }
        }
        catch (Exception)
        {
            _errorMessage = "Failed to load episodes. Please try again.";
        }
        finally
        {
            _isLoading = false;
            await InvokeAsync(StateHasChanged);
        }

        if (_errorMessage is null && _matchEntries.Count > 0)
        {
            await Task.Yield();
            await FocusFirstEntryAsync();
        }
    }

    private async Task FocusFirstEntryAsync()
    {
        if (_matchEntries.Count > 0 && _matchEntries[0].ComboboxRef is EpisodeCombobox combobox)
        {
            await combobox.FocusAndSelectAsync();
        }
    }

    private void TryAutoSelectEpisode(MatchEntry entry)
    {
        if (_allEpisodes.Count == 0)
        {
            return;
        }

        if (!TryGetEpisodeNumber(_episodeTitle, out int episodeNumber))
        {
            return;
        }

        List<int> availableSeasons = [.. _allEpisodes.Select(e => e.SeasonNumber).Distinct().OrderBy(s => s)];
        int? defaultSeason = ResolveDefaultSeason(_siblingEpisodes, availableSeasons);

        IEnumerable<TvdbSeriesEpisode> candidateEpisodes = defaultSeason is not null
            ? _allEpisodes.Where(e => e.SeasonNumber == defaultSeason)
            : _allEpisodes;

        TvdbSeriesEpisode? match = candidateEpisodes.FirstOrDefault(e => e.EpisodeNumber == episodeNumber);
        if (match is not null)
        {
            entry.SelectedEpisodeId = match.TvdbId;
        }
    }

    [System.Diagnostics.CodeAnalysis.SuppressMessage("Minor Code Smell", "S1144", Justification = "Called from Razor template via @onclick")]
    private void AddEntry()
    {
        MatchEntry? lastEntry = _matchEntries.Count > 0 ? _matchEntries[^1] : null;
        MatchEntry entry = new();
        if (lastEntry?.SelectedEpisodeId is not null)
        {
            entry.SelectedEpisodeId = GetNextEpisodeId([.. _allEpisodes], lastEntry.SelectedEpisodeId);
        }
        _matchEntries.Add(entry);
    }

    [System.Diagnostics.CodeAnalysis.SuppressMessage("Minor Code Smell", "S1144", Justification = "Called from Razor template via @onclick")]
    private async Task RemoveEntry(int index)
    {
        _matchEntries.RemoveAt(index);

        if (_matchEntries.Count == 0)
        {
            return;
        }

        await Task.Yield();

        if (_matchEntries.Count == 1)
        {
            await Js.InvokeVoidAsync("focusElement", _addButton);
        }
        else
        {
            int focusIndex = index > 0 ? index - 1 : 0;
            EpisodeCombobox? combobox = _matchEntries[focusIndex].ComboboxRef;
            if (combobox is not null)
            {
                await combobox.FocusAndSelectAsync();
            }
        }
    }

    internal static bool TryGetEpisodeNumber(string title, out int number)
    {
        string[] parts = title.Split(' ');

        if (parts.Length < 2 || !parts[0].Equals("þáttur", StringComparison.OrdinalIgnoreCase))
        {
            number = 0;
            return false;
        }

        return int.TryParse(parts[1], out number);
    }

    internal static int? GetNextEpisodeId(IReadOnlyList<TvdbSeriesEpisode> episodes, int? currentEpisodeId)
    {
        if (currentEpisodeId is null)
        {
            return null;
        }

        int currentIndex = -1;
        for (int i = 0; i < episodes.Count; i++)
        {
            if (episodes[i].TvdbId == currentEpisodeId)
            {
                currentIndex = i;
                break;
            }
        }

        if (currentIndex < 0 || currentIndex >= episodes.Count - 1)
        {
            return null;
        }

        return episodes[currentIndex + 1].TvdbId;
    }

    internal static int? ResolveDefaultSeason(List<EpisodeSummary> siblingEpisodes, List<int> availableSeasons)
    {
        List<int> matchedSeasons = [.. siblingEpisodes
            .SelectMany(e => e.TvdbMatches)
            .Where(m => m.SeasonNumber > 0)
            .Select(m => m.SeasonNumber)
            .Distinct()
            .OrderBy(s => s)];

        if (matchedSeasons.Count > 0)
        {
            int lowest = matchedSeasons[0];
            if (availableSeasons.Contains(lowest))
            {
                return lowest;
            }
        }

        return availableSeasons.Count > 0 ? availableSeasons[0] : null;
    }

    [System.Diagnostics.CodeAnalysis.SuppressMessage("Minor Code Smell", "S1144", Justification = "Called from Razor template via @onclick")]
    private async Task CloseAsync()
    {
        await Js.InvokeVoidAsync("closeDialog", _dialog);
    }

    private void OnDialogClose()
    {
        _ruvId = null;
        _currentMatches = [];
        _allEpisodes = [];
        _matchEntries = [];
        _errorMessage = null;
        _episodeTitle = string.Empty;
        _siblingEpisodes = [];
    }

    [System.Diagnostics.CodeAnalysis.SuppressMessage("Minor Code Smell", "S1144", Justification = "Called from Razor template via @onclick")]
    private async Task SubmitMatch()
    {
        if (_isSubmitting)
        {
            return;
        }

        _isSubmitting = true;

        List<int> tvdbIds = [.. _matchEntries
            .Select(e => e.SelectedEpisodeId)
            .OfType<int>()];

        if (_ruvId is null || tvdbIds.Count == 0)
        {
            _isSubmitting = false;
            return;
        }

        try
        {
            await using AsyncServiceScope scope = ScopeFactory.CreateAsyncScope();
            IRequestHandler<MatchEpisodeCommand> handler =
                scope.ServiceProvider.GetRequiredService<IRequestHandler<MatchEpisodeCommand>>();
            await handler.Handle(new MatchEpisodeCommand(_ruvId, tvdbIds), _cts.Token);
        }
        catch (Exception)
        {
            _errorMessage = "Failed to match episode. Please try again.";
            _isSubmitting = false;
            return;
        }

        _isSubmitting = false;
        await CloseAsync();
        await OnMatchComplete.InvokeAsync();
    }

    private async Task HandleSubmitRequested()
    {
        if (!IsMatchDisabled(_matchEntries, _currentMatches, _isSubmitting))
        {
            await SubmitMatch();
        }
    }

    public async ValueTask DisposeAsync()
    {
        await _cts.CancelAsync();
        _cts.Dispose();
    }

    internal static bool IsMatchDisabled(List<MatchEntry> entries, List<TvdbEpisodeSummary> currentMatches, bool isSubmitting)
    {
        if (isSubmitting)
        {
            return true;
        }

        if (entries.Count == 0)
        {
            return true;
        }

        if (entries.Any(e => e.SelectedEpisodeId is null))
        {
            return true;
        }

        int distinctCount = entries
            .Select(e => e.SelectedEpisodeId)
            .Distinct()
            .Count();

        if (distinctCount != entries.Count)
        {
            return true;
        }

        List<int> selectedIds = [.. entries
            .Select(e => e.SelectedEpisodeId)
            .OfType<int>()
            .Order()];

        List<int> currentIds = [.. currentMatches
            .Select(m => m.TvdbId)
            .Order()];

        return selectedIds.SequenceEqual(currentIds);
    }

    internal sealed class MatchEntry
    {
        public int? SelectedEpisodeId { get; set; }
        public EpisodeCombobox? ComboboxRef { get; set; }
    }
}
