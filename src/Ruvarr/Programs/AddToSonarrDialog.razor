@namespace Ruvarr.Programs
@using Ruvarr.Abstractions
@using Ruvarr.Infrastructure.Sonarr.Models
@using Ruvarr.Programs.Commands.AddProgramToSonarr
@using Ruvarr.Programs.Queries.GetSonarrQualityProfiles
@using Ruvarr.Programs.Queries.GetSonarrRootFolders
@implements IAsyncDisposable
@inject IServiceScopeFactory ScopeFactory
@inject IJSRuntime Js

<dialog @ref="_dialog" @onclose="OnDialogClose">
    <h2>Add to Sonarr</h2>
    @if (_isLoading)
    {
        <div class="dialog-spinner-container" role="status" aria-label="Loading Sonarr configuration">
            <span class="dialog-spinner"></span>
        </div>
    }
    else if (_loadErrorMessage is not null)
    {
        <p class="dialog-error">@_loadErrorMessage</p>
        <button class="dialog-button" @onclick="RetryLoadAsync">Retry</button>
    }
    else
    {
        <label>
            Root Folder
            <select class="dialog-select" disabled="@_isSubmitting" value="@_selectedRootFolderId" @onchange="OnRootFolderChanged">
                @if (_selectedRootFolderId is null)
                {
                    <option value="">-- Select root folder --</option>
                }
                @foreach (RootFolder folder in _rootFolders)
                {
                    <option value="@folder.Id">@folder.Path</option>
                }
            </select>
        </label>
        <label>
            Quality Profile
            <select class="dialog-select" disabled="@_isSubmitting" @bind="_selectedQualityProfileId" @bind:event="onchange">
                @if (_selectedQualityProfileId is null)
                {
                    <option value="">-- Select quality profile --</option>
                }
                @foreach (QualityProfile profile in _qualityProfiles)
                {
                    <option value="@profile.Id">@profile.Name</option>
                }
            </select>
        </label>
        @if (_submitErrorMessage is not null)
        {
            <p class="dialog-error">@_submitErrorMessage</p>
        }
    }
    <div class="dialog-actions">
        @if (!_isLoading)
        {
            <button class="dialog-button dialog-button--primary"
                    @onclick="Submit"
                    disabled="@IsConfirmDisabled(_isSubmitting, _selectedRootFolderId, _selectedQualityProfileId, _loadErrorMessage)"
                    aria-busy="@_isSubmitting">
                @if (_isSubmitting)
                {
                    <span class="button-spinner"></span>
                }
                Confirm
            </button>
        }
        <button class="dialog-button" @onclick="CloseAsync" disabled="@_isSubmitting">Cancel</button>
    </div>
</dialog>

@code {
    [Parameter]
    public EventCallback OnAddComplete { get; set; }

    private ElementReference _dialog;
    private int _ruvId;
    private bool _isLoading;
    private bool _isSubmitting;
    private string? _loadErrorMessage;
    private string? _submitErrorMessage;
    private readonly CancellationTokenSource _cts = new();

    private IReadOnlyList<RootFolder> _rootFolders = [];
    private IReadOnlyList<QualityProfile> _qualityProfiles = [];
    private int? _selectedRootFolderId;
    private int? _selectedQualityProfileId;

    public async Task OpenAsync(int ruvId)
    {
        _ruvId = ruvId;
        _isLoading = true;
        _isSubmitting = false;
        _loadErrorMessage = null;
        _submitErrorMessage = null;
        _rootFolders = [];
        _qualityProfiles = [];
        _selectedRootFolderId = null;
        _selectedQualityProfileId = null;

        await InvokeAsync(StateHasChanged);
        await Js.InvokeVoidAsync("showDialog", _dialog);

        await LoadSonarrConfigAsync();
    }

    [System.Diagnostics.CodeAnalysis.SuppressMessage("Minor Code Smell", "S1144", Justification = "Called from Razor template via @onclick")]
    private async Task RetryLoadAsync()
    {
        _isLoading = true;
        _loadErrorMessage = null;
        await InvokeAsync(StateHasChanged);
        await LoadSonarrConfigAsync();
    }

    private async Task LoadSonarrConfigAsync()
    {
        try
        {
            await using AsyncServiceScope scope = ScopeFactory.CreateAsyncScope();
            IRequestHandler<GetSonarrRootFoldersQuery, IReadOnlyList<RootFolder>> rootFolderHandler =
                scope.ServiceProvider.GetRequiredService<IRequestHandler<GetSonarrRootFoldersQuery, IReadOnlyList<RootFolder>>>();
            IRequestHandler<GetSonarrQualityProfilesQuery, IReadOnlyList<QualityProfile>> qualityProfileHandler =
                scope.ServiceProvider.GetRequiredService<IRequestHandler<GetSonarrQualityProfilesQuery, IReadOnlyList<QualityProfile>>>();

            Task<IReadOnlyList<RootFolder>> rootFoldersTask = rootFolderHandler.Handle(new GetSonarrRootFoldersQuery(), _cts.Token);
            Task<IReadOnlyList<QualityProfile>> qualityProfilesTask = qualityProfileHandler.Handle(new GetSonarrQualityProfilesQuery(), _cts.Token);

            await Task.WhenAll(rootFoldersTask, qualityProfilesTask);

            _rootFolders = await rootFoldersTask;
            _qualityProfiles = await qualityProfilesTask;

            if (_rootFolders.Count == 0 || _qualityProfiles.Count == 0)
            {
                _loadErrorMessage = "Failed to load Sonarr configuration. Please check your Sonarr connection.";
            }
        }
        catch (Exception)
        {
            _loadErrorMessage = "Failed to load Sonarr configuration. Please try again.";
        }
        finally
        {
            _isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void OnRootFolderChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int id))
        {
            _selectedRootFolderId = id;
        }
        else
        {
            _selectedRootFolderId = null;
        }
    }

    [System.Diagnostics.CodeAnalysis.SuppressMessage("Minor Code Smell", "S1144", Justification = "Called from Razor template via @onclick")]
    private async Task CloseAsync()
    {
        await Js.InvokeVoidAsync("closeDialog", _dialog);
    }

    private void OnDialogClose()
    {
        _ruvId = 0;
        _rootFolders = [];
        _qualityProfiles = [];
        _selectedRootFolderId = null;
        _selectedQualityProfileId = null;
        _loadErrorMessage = null;
        _submitErrorMessage = null;
    }

    [System.Diagnostics.CodeAnalysis.SuppressMessage("Minor Code Smell", "S1144", Justification = "Called from Razor template via @onclick")]
    private async Task Submit()
    {
        if (_isSubmitting)
        {
            return;
        }

        _isSubmitting = true;
        _submitErrorMessage = null;

        if (_selectedRootFolderId is null || _selectedQualityProfileId is null)
        {
            _isSubmitting = false;
            return;
        }

        string? rootFolderPath = _rootFolders.FirstOrDefault(f => f.Id == _selectedRootFolderId)?.Path;
        if (rootFolderPath is null)
        {
            _isSubmitting = false;
            return;
        }

        try
        {
            await using AsyncServiceScope scope = ScopeFactory.CreateAsyncScope();
            IRequestHandler<AddProgramToSonarrCommand> handler =
                scope.ServiceProvider.GetRequiredService<IRequestHandler<AddProgramToSonarrCommand>>();
            RuvarrResult result = await handler.Handle(
                new AddProgramToSonarrCommand(_ruvId, _selectedQualityProfileId.Value, rootFolderPath),
                _cts.Token);

            if (!result.IsSuccess)
            {
                _submitErrorMessage = result.Error.Description;
                return;
            }
        }
        catch (Exception)
        {
            _submitErrorMessage = "Failed to add series to Sonarr. Please try again.";
            return;
        }
        finally
        {
            _isSubmitting = false;
        }

        await CloseAsync();
        await OnAddComplete.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        await _cts.CancelAsync();
        _cts.Dispose();
    }

    internal static bool IsConfirmDisabled(bool isSubmitting, int? selectedRootFolderId, int? selectedQualityProfileId, string? loadErrorMessage)
    {
        if (isSubmitting)
        {
            return true;
        }

        if (loadErrorMessage is not null)
        {
            return true;
        }

        if (selectedRootFolderId is null || selectedQualityProfileId is null)
        {
            return true;
        }

        return false;
    }
}
