@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using Ruvarr.Abstractions
@using Ruvarr.Contracts
@using Ruvarr.ProgramRefreshQueue.Notifiers
@using Ruvarr.Programs.Commands.MatchProgram
@using Ruvarr.Programs.Commands.RefreshProgram
@using Ruvarr.Programs.Events
@using Ruvarr.Programs.Queries.GetPrograms
@inject IServiceScopeFactory ScopeFactory
@inject ProgramRefreshNotifier RefreshNotifier
@inject IDomainEventBroadcaster Broadcaster
@inject ProgramsFilterState FilterState
@inject IJSRuntime JS

<h1>Programs</h1>

<div class="filter-panel">
    <label class="filter-chip @(FilterState.FilterUnmatchedPrograms ? "filter-chip--active" : "")">
        <input type="checkbox" @bind="FilterState.FilterUnmatchedPrograms" @bind:after="LoadProgramsAsync" />
        Unmatched Programs
    </label>
    <label class="filter-chip @(FilterState.FilterUnmatchedEpisodes ? "filter-chip--active" : "")">
        <input type="checkbox" @bind="FilterState.FilterUnmatchedEpisodes" @bind:after="LoadProgramsAsync" />
        Unmatched Episodes
    </label>
    <label class="filter-chip @(FilterState.FilterMissingFromSonarr ? "filter-chip--active" : "")">
        <input type="checkbox" @bind="FilterState.FilterMissingFromSonarr" @bind:after="LoadProgramsAsync" />
        Missing from Sonarr
    </label>
    <label class="filter-chip @(FilterState.FilterPartiallyMatched ? "filter-chip--active" : "")">
        <input type="checkbox" @bind="FilterState.FilterPartiallyMatched" @bind:after="LoadProgramsAsync" />
        Partially Matched
    </label>
    <label class="filter-chip @(FilterState.FilterMonitored ? "filter-chip--active" : "")">
        <input type="checkbox" @bind="FilterState.FilterMonitored" @bind:after="LoadProgramsAsync" />
        Monitored
    </label>
    <span class="filter-divider"></span>
    <select class="filter-select" @bind="FilterState.FilterChannel" @bind:after="ResetScrollPosition">
        <option value="">All channels</option>
        @foreach (string channel in _channels)
        {
            <option value="@channel">@channel</option>
        }
    </select>
    <button class="filter-clear" @onclick="ClearFilters" disabled="@(!FilterState.HasActiveFilters)">Clear filters</button>
</div>

<div class="search-bar">
    <input type="text" placeholder="Search programs..." @bind="FilterState.SearchText" @bind:event="oninput" @bind:after="ResetScrollPosition" />
</div>

@if (_programs is null)
{
    <div class="spinner"></div>
}
else
{
    List<ProgramSummary> visibleList = [.. _programs
        .Where(p => string.IsNullOrWhiteSpace(FilterState.SearchText) || p.ProgramName.Contains(FilterState.SearchText, StringComparison.OrdinalIgnoreCase))
        .Where(p => string.IsNullOrEmpty(FilterState.FilterChannel) || p.Channel == FilterState.FilterChannel)];

    if (visibleList.Count == 0)
    {
        <p class="empty-message">@((FilterState.HasActiveFilters, FilterState.HasSearchText) switch
        {
            (true, true) => "No programs match the selected filters and search.",
            (false, true) => "No programs match your search.",
            (true, false) => "No programs match the selected filters.",
            _ => "No programs found."
        })</p>
    }
    else
    {
        <MatchProgramDialog @ref="_matchProgramDialog" OnMatchComplete="LoadProgramsAsync" />
        <table class="programs-table">
            <thead>
                <tr>
                    <th>Program</th>
                    <th>Channel</th>
                    <th class="col-center">Monitored</th>
                    <th class="col-center">Missing</th>
                    <th>TVDB Series</th>
                    <th class="col-center">Matched</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <Virtualize Items="visibleList" Context="program" ItemSize="48" OverscanCount="5">
                    <tr @key="program.ProgramRuvId">
                        <td><a class="program-link" href="/program/@program.ProgramRuvId">@program.ProgramName</a></td>
                        <td><span class="channel-tag">@program.Channel</span></td>
                        <td class="col-center">
                            @if (program.IsMonitored)
                            {
                                <Icon Type="IconType.Eye" Class="icon icon--monitored" AriaLabel="Monitored" />
                            }
                            else
                            {
                                <Icon Type="IconType.EyeOff" Class="icon icon--unmonitored" AriaLabel="Unmonitored" />
                            }
                        </td>
                        <td class="col-center">
                            @if (program.HasMissingEpisodes)
                            {
                                <Icon Type="IconType.Warning" Class="icon icon--missing" AriaLabel="Missing episodes" />
                            }
                        </td>
                        <td>
                            @if (program.TvdbUrl is not null)
                            {
                                <a class="series-link" href="@program.TvdbUrl" target="_blank" rel="noopener noreferrer">@program.SeriesName</a>
                            }
                            else if (program.SeriesName is not null)
                            {
                                <span>@program.SeriesName</span>
                            }
                            else
                            {
                                <span class="unmatched-dash">—</span>
                            }
                        </td>
                        <td class="col-center">
                            @{
                                (string cssClass, string ariaLabel) = program.EpisodeMatchStatus switch
                                {
                                    EpisodeMatchStatus.FullyMatched => ("icon--matched-all", "All episodes matched"),
                                    EpisodeMatchStatus.PartiallyMatched => ("icon--matched-partial", "Some episodes matched"),
                                    _ => ("icon--matched-none", "No episodes matched"),
                                };
                            }
                            <Icon Type="IconType.CheckmarkCircle" Class="@($"icon {cssClass}")" AriaLabel="@ariaLabel" />
                        </td>
                        <td>
                            <div class="row-actions">
                                @if (program.TvdbSeriesId is null)
                                {
                                    <button class="icon-button" @onclick="() => OpenMatchProgramDialog(program)" title="Match to TVDB">
                                        <Icon Type="IconType.Link" Class="icon" AriaLabel="Match to TVDB" />
                                    </button>
                                }
                                @if (program.RuvUrl is not null)
                                {
                                    <a class="icon-button" href="@program.RuvUrl" target="_blank" rel="noopener noreferrer" title="View on RÚV">
                                        <Icon Type="IconType.ExternalLink" Class="icon" AriaLabel="View on RÚV" />
                                    </a>
                                }
                                @if (_refreshQueue.TryGetValue(program.ProgramRuvId, out ProgramRefreshStatus status) && status == ProgramRefreshStatus.Processing)
                                {
                                    <span class="icon-button">
                                        <Icon Type="IconType.Spinner" Class="icon icon--spinning" AriaLabel="Refreshing" />
                                    </span>
                                }
                                else if (_refreshQueue.ContainsKey(program.ProgramRuvId) || _pendingRefresh.Contains(program.ProgramRuvId))
                                {
                                    <span class="icon-button">
                                        <Icon Type="IconType.Clock" Class="icon" AriaLabel="Pending" />
                                    </span>
                                }
                                else
                                {
                                    <button class="icon-button" @onclick="() => RefreshProgram(program.ProgramRuvId)" title="Refresh">
                                        <Icon Type="IconType.Refresh" Class="icon" AriaLabel="Refresh" />
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                </Virtualize>
            </tbody>
        </table>
    }
}

@code {
    private List<string> _channels = [];

    private MatchProgramDialog? _matchProgramDialog;
    private List<ProgramSummary>? _programs;
    private readonly HashSet<int> _pendingRefresh = [];
    private Dictionary<int, ProgramRefreshStatus> _refreshQueue = [];
    private readonly CancellationTokenSource _cts = new();
    private bool _shouldRestoreScroll;
    private bool _dataLoaded;

    protected override Task OnInitializedAsync()
    {
        _shouldRestoreScroll = FilterState.ScrollPositionY > 0;
        _ = WatchAsync();
        _ = WatchCreatedAsync();
        _ = LoadProgramsCoreAsync();
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("startScrollTracking");
        }

        if (_shouldRestoreScroll && _dataLoaded)
        {
            _shouldRestoreScroll = false;
            await JS.InvokeVoidAsync("setScrollY", FilterState.ScrollPositionY);
        }
    }

    private async Task WatchAsync()
    {
        await foreach (QueueChangedEvent<ProgramRefreshQueueItemSummary> _ in Broadcaster.Subscribe<QueueChangedEvent<ProgramRefreshQueueItemSummary>>(_cts.Token))
        {
            _refreshQueue = RefreshNotifier.Items.ToDictionary(x => x.RuvId, x => x.Status);
            foreach (int ruvId in _pendingRefresh.Where(id => _refreshQueue.ContainsKey(id)).ToList())
            {
                _pendingRefresh.Remove(ruvId);
            }
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task WatchCreatedAsync()
    {
        await foreach (ProgramCreatedEvent _ in Broadcaster.Subscribe<ProgramCreatedEvent>(_cts.Token))
        {
            await LoadProgramsCoreAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            FilterState.ScrollPositionY = await JS.InvokeAsync<double>("stopScrollTracking");
        }
        catch (JSDisconnectedException)
        {
            // Expected when the circuit is disconnected during disposal
        }
        catch (ObjectDisposedException)
        {
            // Expected when the JS runtime is disposed during disposal
        }

        await _cts.CancelAsync();
        _cts.Dispose();
    }

    private void ResetScrollPosition()
    {
        FilterState.ScrollPositionY = 0;
    }

    private async Task ClearFilters()
    {
        FilterState.Clear();
        await LoadProgramsAsync();
    }

    private async Task LoadProgramsAsync()
    {
        FilterState.ScrollPositionY = 0;
        await LoadProgramsCoreAsync();
    }

    private async Task LoadProgramsCoreAsync()
    {
        _programs = null;
        await InvokeAsync(StateHasChanged);

        bool? isProgramMatched = (FilterState.FilterUnmatchedPrograms, FilterState.FilterUnmatchedEpisodes) switch
        {
            (true, false) => false,
            (false, true) => true,
            _ => null
        };

        bool? isEpisodeMatched = FilterState.FilterUnmatchedEpisodes ? false : null;

        bool? isProgramMonitored = (FilterState.FilterMonitored || FilterState.FilterMissingFromSonarr) ? true : null;

        bool? isProgramMissingEpisodes = FilterState.FilterMissingFromSonarr ? true : null;

        bool? isProgramPartiallyMatched = FilterState.FilterPartiallyMatched ? true : null;

        GetProgramsQuery query = new(
            null,
            isProgramMonitored,
            isProgramMissingEpisodes,
            isProgramMatched,
            isProgramPartiallyMatched,
            isEpisodeMatched);

        List<ProgramSummary> loaded = [];
        await using (AsyncServiceScope scope = ScopeFactory.CreateAsyncScope())
        {
            IStreamingRequestHandler<GetProgramsQuery, ProgramSummary> handler =
                scope.ServiceProvider.GetRequiredService<IStreamingRequestHandler<GetProgramsQuery, ProgramSummary>>();
            await foreach (ProgramSummary program in handler.Handle(query, _cts.Token))
            {
                loaded.Add(program);
            }
        }

        _programs = loaded;
        _dataLoaded = true;
        _channels = [.. _programs.Select(p => p.Channel).Distinct().Order()];

        if (!string.IsNullOrEmpty(FilterState.FilterChannel) && !_channels.Contains(FilterState.FilterChannel))
        {
            FilterState.FilterChannel = string.Empty;
        }

        await InvokeAsync(StateHasChanged);
    }

    [System.Diagnostics.CodeAnalysis.SuppressMessage("Minor Code Smell", "S1144", Justification = "Called from Razor template via @onclick")]
    private async Task OpenMatchProgramDialog(ProgramSummary program)
    {
        await _matchProgramDialog!.OpenAsync(program.ProgramRuvId, program.TvdbSeriesId, program.ProgramName);
    }

    [System.Diagnostics.CodeAnalysis.SuppressMessage("Minor Code Smell", "S1144", Justification = "Called from Razor template via @onclick")]
    private async Task RefreshProgram(int ruvId)
    {
        _pendingRefresh.Add(ruvId);
        await using AsyncServiceScope scope = ScopeFactory.CreateAsyncScope();
        IRequestHandler<RefreshProgramCommand> handler =
            scope.ServiceProvider.GetRequiredService<IRequestHandler<RefreshProgramCommand>>();
        await handler.Handle(new RefreshProgramCommand(ruvId), _cts.Token);
    }
}
