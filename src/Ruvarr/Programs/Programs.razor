@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using Ruvarr.Abstractions
@using Ruvarr.Contracts
@using Ruvarr.ProgramRefreshQueue.Notifiers
@using Ruvarr.Programs.Commands.MatchProgram
@using Ruvarr.Programs.Commands.RefreshProgram
@using Ruvarr.Programs.Events
@using Ruvarr.Programs.Filters
@using Ruvarr.Programs.Queries.GetPrograms
@inject IServiceScopeFactory ScopeFactory
@inject ProgramRefreshNotifier RefreshNotifier
@inject IDomainEventBroadcaster Broadcaster
@inject ProgramsFilterState FilterState
@inject IJSRuntime JS

<h1>Programs</h1>

<div class="filter-panel">
    <div class="filter-group" role="group" aria-label="Program filters">
        <span class="filter-group-label">Programs</span>
        <button class="filter-chip @(FilterState.FilterMatch != MatchFilter.All ? "filter-chip--active" : "")"
                aria-pressed="@(FilterState.FilterMatch != MatchFilter.All)"
                type="button"
                @onclick="ToggleMatchFilter">
            @(FilterState.FilterMatch switch
            {
                MatchFilter.Matched => "Matched",
                MatchFilter.Unmatched => "Unmatched",
                _ => "Match: All"
            })
        </button>
        <button class="filter-chip @(FilterState.FilterMonitored != MonitoredFilter.All ? "filter-chip--active" : "")"
                aria-pressed="@(FilterState.FilterMonitored != MonitoredFilter.All)"
                type="button"
                @onclick="ToggleMonitored">
            @(FilterState.FilterMonitored switch
            {
                MonitoredFilter.Monitored => "Monitored",
                MonitoredFilter.NotMonitored => "Not Monitored",
                _ => "Monitored: All"
            })
        </button>
        <button class="filter-chip @(FilterState.FilterMissingEpisodes != MissingEpisodesFilter.All ? "filter-chip--active" : "")"
                aria-pressed="@(FilterState.FilterMissingEpisodes != MissingEpisodesFilter.All)"
                type="button"
                @onclick="ToggleMissing">
            @(FilterState.FilterMissingEpisodes switch
            {
                MissingEpisodesFilter.MissingEpisodes => "Missing Episodes",
                MissingEpisodesFilter.NotMissingEpisodes => "Not Missing Episodes",
                _ => "Missing: All"
            })
        </button>
        <button class="filter-chip @(FilterState.FilterPendingLookup != PendingLookupFilter.All ? "filter-chip--active" : "")"
                aria-pressed="@(FilterState.FilterPendingLookup != PendingLookupFilter.All)"
                type="button"
                @onclick="TogglePendingLookup">
            @(FilterState.FilterPendingLookup switch
            {
                PendingLookupFilter.PendingLookup => "Pending Lookup",
                PendingLookupFilter.NotPendingLookup => "Not Pending",
                _ => "Pending: All"
            })
        </button>
        <button class="filter-chip @(FilterState.FilterForeignName != ForeignNameFilter.All ? "filter-chip--active" : "")"
                aria-pressed="@(FilterState.FilterForeignName != ForeignNameFilter.All)"
                type="button"
                @onclick="ToggleForeignName">
            @(FilterState.FilterForeignName switch
            {
                ForeignNameFilter.HasForeignName => "Has Foreign Name",
                ForeignNameFilter.NoForeignName => "No Foreign Name",
                _ => "Foreign Name: All"
            })
        </button>
    </div>
    <span class="filter-divider"></span>
    <div class="filter-group" role="group" aria-label="Episode filters">
        <span class="filter-group-label">Episodes</span>
        <button class="filter-chip @(FilterState.FilterEpisodeMatch != EpisodeMatchFilter.All ? "filter-chip--active" : "")"
                aria-pressed="@(FilterState.FilterEpisodeMatch != EpisodeMatchFilter.All)"
                type="button"
                @onclick="ToggleEpisodeMatchFilter">
            @(FilterState.FilterEpisodeMatch switch
            {
                EpisodeMatchFilter.FullyMatched => "All Matched",
                EpisodeMatchFilter.PartiallyMatched => "Partial Match",
                EpisodeMatchFilter.NoneMatched => "None Matched",
                _ => "Match: All"
            })
        </button>
    </div>
    <span class="filter-divider"></span>
    <select class="filter-select" @bind="FilterState.FilterChannel" @bind:after="ResetScrollPosition">
        <option value="">All channels</option>
        @foreach (string channel in _channels)
        {
            <option value="@channel">@channel</option>
        }
    </select>
    <button class="filter-clear" @onclick="ClearFilters" disabled="@(!FilterState.HasActiveFilters)">Clear filters</button>
</div>

<div class="search-bar">
    <input type="text" placeholder="Search programs..." @bind="FilterState.SearchText" @bind:event="oninput" @bind:after="ResetScrollPosition" />
</div>

@if (_programs is null)
{
    <div class="spinner"></div>
}
else
{
    List<ProgramSummary> visibleList = [.. _programs
        .Where(p => string.IsNullOrWhiteSpace(FilterState.SearchText) || p.ProgramName.Contains(FilterState.SearchText, StringComparison.OrdinalIgnoreCase))
        .Where(p => string.IsNullOrEmpty(FilterState.FilterChannel) || p.Channel == FilterState.FilterChannel)];

    if (visibleList.Count == 0)
    {
        <p class="empty-message">@((FilterState.HasActiveFilters, FilterState.HasSearchText) switch
        {
            (true, true) => "No programs match the selected filters and search.",
            (false, true) => "No programs match your search.",
            (true, false) => "No programs match the selected filters.",
            _ => "No programs found."
        })</p>
    }
    else
    {
        <MatchProgramDialog @ref="_matchProgramDialog" OnMatchComplete="LoadProgramsAsync" />
        <table class="programs-table">
            <thead>
                <tr>
                    <th>Program</th>
                    <th>Channel</th>
                    <th>TVDB Series</th>
                    <th class="col-center"></th>
                    <th class="col-center"></th>
                    <th class="col-center"></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <Virtualize Items="visibleList" Context="program" ItemSize="48" OverscanCount="5">
                    <tr @key="program.ProgramRuvId">
                        <td><a class="program-link" href="/program/@program.ProgramRuvId">@program.ProgramName</a></td>
                        <td><span class="channel-tag">@program.Channel</span></td>
                        <td>
                            @if (program.TvdbUrl is not null)
                            {
                                <a class="series-link" href="@program.TvdbUrl" target="_blank" rel="noopener noreferrer">@program.SeriesName</a>
                            }
                            else if (program.SeriesName is not null)
                            {
                                <span>@program.SeriesName</span>
                            }
                            else
                            {
                                <span class="unmatched-dash">—</span>
                            }
                        </td>
                        <td class="col-center">
                            @if (program.HasMissingEpisodes)
                            {
                                <span title="Missing episodes"><Icon Type="IconType.Warning" Class="icon icon--missing" AriaLabel="Missing episodes" /></span>
                            }
                        </td>
                        <td class="col-center">
                            @if (program.IsMonitored)
                            {
                                <span title="Monitored"><Icon Type="IconType.Eye" Class="icon icon--monitored" AriaLabel="Monitored" /></span>
                            }
                            else
                            {
                                <span title="Unmonitored"><Icon Type="IconType.EyeOff" Class="icon icon--unmonitored" AriaLabel="Unmonitored" /></span>
                            }
                        </td>
                        <td class="col-center">
                            @{
                                (string cssClass, string ariaLabel) = program.EpisodeMatchStatus switch
                                {
                                    EpisodeMatchStatus.FullyMatched => ("icon--matched-all", "All episodes matched"),
                                    EpisodeMatchStatus.PartiallyMatched => ("icon--matched-partial", "Some episodes matched"),
                                    _ => ("icon--matched-none", "No episodes matched"),
                                };
                            }
                            <span title="@ariaLabel"><Icon Type="IconType.CheckmarkCircle" Class="@($"icon {cssClass}")" AriaLabel="@ariaLabel" /></span>
                        </td>
                        <td>
                            <div class="row-actions">
                                @if (program.TvdbSeriesId is null)
                                {
                                    <button class="icon-button" @onclick="() => OpenMatchProgramDialog(program)" title="Match to TVDB">
                                        <Icon Type="IconType.Link" Class="icon" AriaLabel="Match to TVDB" />
                                    </button>
                                }
                                @if (program.RuvUrl is not null)
                                {
                                    <a class="icon-button" href="@program.RuvUrl" target="_blank" rel="noopener noreferrer" title="View on RÚV">
                                        <Icon Type="IconType.ExternalLink" Class="icon" AriaLabel="View on RÚV" />
                                    </a>
                                }
                                @if (_refreshQueue.TryGetValue(program.ProgramRuvId, out ProgramRefreshStatus status) && status == ProgramRefreshStatus.Processing)
                                {
                                    <span class="icon-button" title="Refreshing">
                                        <Icon Type="IconType.Spinner" Class="icon icon--spinning" AriaLabel="Refreshing" />
                                    </span>
                                }
                                else if (_refreshQueue.ContainsKey(program.ProgramRuvId) || _pendingRefresh.Contains(program.ProgramRuvId))
                                {
                                    <span class="icon-button" title="Queued for refresh">
                                        <Icon Type="IconType.Clock" Class="icon" AriaLabel="Pending" />
                                    </span>
                                }
                                else
                                {
                                    <button class="icon-button" @onclick="() => RefreshProgram(program.ProgramRuvId)" title="Refresh">
                                        <Icon Type="IconType.Refresh" Class="icon" AriaLabel="Refresh" />
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                </Virtualize>
            </tbody>
        </table>
    }
}

@code {
    private List<string> _channels = [];

    private MatchProgramDialog? _matchProgramDialog;
    private List<ProgramSummary>? _programs;
    private readonly HashSet<int> _pendingRefresh = [];
    private Dictionary<int, ProgramRefreshStatus> _refreshQueue = [];
    private readonly CancellationTokenSource _cts = new();
    private bool _shouldRestoreScroll;
    private bool _dataLoaded;

    protected override Task OnInitializedAsync()
    {
        _shouldRestoreScroll = FilterState.ScrollPositionY > 0;
        _ = WatchAsync();
        _ = WatchCreatedAsync();
        _ = LoadProgramsCoreAsync();
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("startScrollTracking");
        }

        if (_shouldRestoreScroll && _dataLoaded)
        {
            _shouldRestoreScroll = false;
            await JS.InvokeVoidAsync("setScrollY", FilterState.ScrollPositionY);
        }
    }

    private async Task WatchAsync()
    {
        await foreach (QueueChangedEvent<ProgramRefreshQueueItemSummary> _ in Broadcaster.Subscribe<QueueChangedEvent<ProgramRefreshQueueItemSummary>>(_cts.Token))
        {
            _refreshQueue = RefreshNotifier.Items.ToDictionary(x => x.RuvId, x => x.Status);
            foreach (int ruvId in _pendingRefresh.Where(id => _refreshQueue.ContainsKey(id)).ToList())
            {
                _pendingRefresh.Remove(ruvId);
            }
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task WatchCreatedAsync()
    {
        await foreach (ProgramCreatedEvent _ in Broadcaster.Subscribe<ProgramCreatedEvent>(_cts.Token))
        {
            await LoadProgramsCoreAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            FilterState.ScrollPositionY = await JS.InvokeAsync<double>("stopScrollTracking");
        }
        catch (JSDisconnectedException)
        {
            // Expected when the circuit is disconnected during disposal
        }
        catch (ObjectDisposedException)
        {
            // Expected when the JS runtime is disposed during disposal
        }

        await _cts.CancelAsync();
        _cts.Dispose();
    }

    private void ResetScrollPosition()
    {
        FilterState.ScrollPositionY = 0;
    }

    private async Task ClearFilters()
    {
        FilterState.Clear();
        await LoadProgramsAsync();
    }

    private async Task LoadProgramsAsync()
    {
        FilterState.ScrollPositionY = 0;
        await LoadProgramsCoreAsync();
    }

    private async Task LoadProgramsCoreAsync()
    {
        _programs = null;
        await InvokeAsync(StateHasChanged);

        GetProgramsQuery query = new(
            null,
            FilterState.FilterMatch switch
            {
                MatchFilter.Matched => false,
                MatchFilter.Unmatched => true,
                _ => null
            },
            FilterState.FilterMonitored switch
            {
                MonitoredFilter.Monitored => true,
                MonitoredFilter.NotMonitored => false,
                _ => null
            },
            FilterState.FilterMissingEpisodes switch
            {
                MissingEpisodesFilter.MissingEpisodes => true,
                MissingEpisodesFilter.NotMissingEpisodes => false,
                _ => null
            },
            FilterState.FilterPendingLookup switch
            {
                PendingLookupFilter.PendingLookup => true,
                PendingLookupFilter.NotPendingLookup => false,
                _ => null
            },
            FilterState.FilterForeignName switch
            {
                ForeignNameFilter.HasForeignName => true,
                ForeignNameFilter.NoForeignName => false,
                _ => null
            },
            FilterState.FilterEpisodeMatch switch
            {
                EpisodeMatchFilter.FullyMatched => EpisodeMatchStatus.FullyMatched,
                EpisodeMatchFilter.PartiallyMatched => EpisodeMatchStatus.PartiallyMatched,
                EpisodeMatchFilter.NoneMatched => EpisodeMatchStatus.NoneMatched,
                _ => null
            });

        List<ProgramSummary> loaded = [];
        await using (AsyncServiceScope scope = ScopeFactory.CreateAsyncScope())
        {
            IStreamingRequestHandler<GetProgramsQuery, ProgramSummary> handler =
                scope.ServiceProvider.GetRequiredService<IStreamingRequestHandler<GetProgramsQuery, ProgramSummary>>();
            await foreach (ProgramSummary program in handler.Handle(query, _cts.Token))
            {
                loaded.Add(program);
            }
        }

        _programs = loaded;
        _dataLoaded = true;
        _channels = [.. _programs.Select(p => p.Channel).Distinct().Order()];

        if (!string.IsNullOrEmpty(FilterState.FilterChannel) && !_channels.Contains(FilterState.FilterChannel))
        {
            FilterState.FilterChannel = string.Empty;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleMatchFilter()
    {
        FilterState.FilterMatch = FilterState.FilterMatch switch
        {
            MatchFilter.All => MatchFilter.Matched,
            MatchFilter.Matched => MatchFilter.Unmatched,
            _ => MatchFilter.All
        };
        await LoadProgramsAsync();
    }

    private async Task ToggleMonitored()
    {
        FilterState.FilterMonitored = FilterState.FilterMonitored switch
        {
            MonitoredFilter.All => MonitoredFilter.Monitored,
            MonitoredFilter.Monitored => MonitoredFilter.NotMonitored,
            _ => MonitoredFilter.All
        };
        await LoadProgramsAsync();
    }

    private async Task ToggleMissing()
    {
        FilterState.FilterMissingEpisodes = FilterState.FilterMissingEpisodes switch
        {
            MissingEpisodesFilter.All => MissingEpisodesFilter.MissingEpisodes,
            MissingEpisodesFilter.MissingEpisodes => MissingEpisodesFilter.NotMissingEpisodes,
            _ => MissingEpisodesFilter.All
        };
        await LoadProgramsAsync();
    }

    private async Task TogglePendingLookup()
    {
        FilterState.FilterPendingLookup = FilterState.FilterPendingLookup switch
        {
            PendingLookupFilter.All => PendingLookupFilter.PendingLookup,
            PendingLookupFilter.PendingLookup => PendingLookupFilter.NotPendingLookup,
            _ => PendingLookupFilter.All
        };
        await LoadProgramsAsync();
    }

    private async Task ToggleEpisodeMatchFilter()
    {
        FilterState.FilterEpisodeMatch = FilterState.FilterEpisodeMatch switch
        {
            EpisodeMatchFilter.All => EpisodeMatchFilter.FullyMatched,
            EpisodeMatchFilter.FullyMatched => EpisodeMatchFilter.PartiallyMatched,
            EpisodeMatchFilter.PartiallyMatched => EpisodeMatchFilter.NoneMatched,
            _ => EpisodeMatchFilter.All
        };
        await LoadProgramsAsync();
    }

    private async Task ToggleForeignName()
    {
        FilterState.FilterForeignName = FilterState.FilterForeignName switch
        {
            ForeignNameFilter.All => ForeignNameFilter.HasForeignName,
            ForeignNameFilter.HasForeignName => ForeignNameFilter.NoForeignName,
            _ => ForeignNameFilter.All
        };
        await LoadProgramsAsync();
    }

    [System.Diagnostics.CodeAnalysis.SuppressMessage("Minor Code Smell", "S1144", Justification = "Called from Razor template via @onclick")]
    private async Task OpenMatchProgramDialog(ProgramSummary program)
    {
        await _matchProgramDialog!.OpenAsync(program.ProgramRuvId, program.TvdbSeriesId, program.ProgramName);
    }

    [System.Diagnostics.CodeAnalysis.SuppressMessage("Minor Code Smell", "S1144", Justification = "Called from Razor template via @onclick")]
    private async Task RefreshProgram(int ruvId)
    {
        _pendingRefresh.Add(ruvId);
        await using AsyncServiceScope scope = ScopeFactory.CreateAsyncScope();
        IRequestHandler<RefreshProgramCommand> handler =
            scope.ServiceProvider.GetRequiredService<IRequestHandler<RefreshProgramCommand>>();
        await handler.Handle(new RefreshProgramCommand(ruvId), _cts.Token);
    }
}
