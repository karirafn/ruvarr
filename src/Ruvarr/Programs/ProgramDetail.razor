@page "/program/{RuvId:int}"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IAsyncDisposable
@using Microsoft.JSInterop
@using Ruvarr.Abstractions
@using Ruvarr.Contracts
@using Ruvarr.Downloads.Events
@using Ruvarr.ProgramRefreshQueue.Notifiers
@using Ruvarr.Programs.Events
@using Ruvarr.Programs.Commands.DownloadEpisode
@using Ruvarr.Programs.Commands.MatchProgram
@using Ruvarr.Programs.Commands.RefreshProgram
@using Ruvarr.Programs.Queries.GetProgram
@using Ruvarr.Programs.Queries.GetProgramEpisodes
@inject IJSRuntime Js
@inject IServiceScopeFactory ScopeFactory
@inject ProgramRefreshNotifier RefreshNotifier
@inject IDomainEventBroadcaster Broadcaster

<a class="detail-back" href="/programs">
    <Icon Type="IconType.BackArrow" Width="14" Height="14" />
    Programs
</a>

@if (_notFound)
{
    <div class="empty-state">
        <p>Program not found.</p>
        <a class="detail-back" href="/programs">Back to programs</a>
    </div>
}
else if (_program is null)
{
    <div class="spinner"></div>
}
else
{
    <div class="program-header">
        @if (_program.ImageUrl is not null)
        {
            <img @key="@_program.ImageUrl" class="program-thumbnail" src="@_program.ImageUrl" alt="@_program.ProgramName" width="288" height="400" decoding="async" />
        }
        <div class="program-header-content">
        <div class="program-header-meta">
            <span class="channel-tag">@_program.Channel</span>
            @if (_program.IsMonitored)
            {
                <span class="status-pill status-pill--monitored">Monitored</span>
            }
            else
            {
                <span class="status-pill status-pill--unmonitored">Unmonitored</span>
            }
            @if (_refreshQueue.TryGetValue(_program.ProgramRuvId, out ProgramRefreshStatus status) && status == ProgramRefreshStatus.Processing)
            {
                <span class="icon-button">
                    <Icon Type="IconType.Spinner" Class="icon icon--spinning" AriaLabel="Refreshing" />
                </span>
            }
            else if (_refreshQueue.ContainsKey(_program.ProgramRuvId) || _pendingRefresh.Contains(_program.ProgramRuvId))
            {
                <span class="icon-button">
                    <Icon Type="IconType.Clock" Class="icon" AriaLabel="Pending" />
                </span>
            }
            else
            {
                <button class="icon-button" @onclick="() => RefreshProgram(_program.ProgramRuvId)" title="Refresh program">
                    <Icon Type="IconType.Refresh" Class="icon" AriaLabel="Refresh" />
                </button>
            }
        </div>
        <h1>@_program.ProgramName</h1>
        <div class="series-meta">
            @if (_program.SeriesName is not null)
            {
                <span class="series-name">@_program.SeriesName</span>
            }
            @if (_program.TvdbUrl is not null)
            {
                <a class="badge--tvdb" href="@_program.TvdbUrl" target="_blank" rel="noopener noreferrer">TVDB</a>
            }
            @if (_program.RuvUrl is not null)
            {
                <a class="badge--ruv" href="@_program.RuvUrl" target="_blank" rel="noopener noreferrer">RÚV</a>
            }
            @if (_program.TvdbSeriesId is null)
            {
                <button class="badge--tvdb-create" @onclick="CreateOnTvdb" title="Create series on TVDB">
                    <Icon Type="IconType.Plus" Width="12" Height="12" /> TVDB
                </button>
            }
            <button class="action-button" @onclick="OpenMatchProgramDialog" title="@GetMatchButtonLabel(_program.TvdbSeriesId, _program.IsMovieMatch)">
                <Icon Type="IconType.Link" Width="12" Height="12" /> @GetMatchButtonLabel(_program.TvdbSeriesId, _program.IsMovieMatch)
            </button>
            @if (_program.TvdbSeriesId is not null && !_program.IsMonitored && !_program.IsMovieMatch)
            {
                <button class="action-button" @onclick="OpenAddToSonarrDialog">
                    <Icon Type="IconType.Plus" Width="12" Height="12" /> Add to Sonarr
                </button>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(_program.Description))
        {
            <div class="program-description">
                @foreach (string paragraph in _program.Description.Split("\n\n", StringSplitOptions.RemoveEmptyEntries))
                {
                    <p>@paragraph</p>
                }
            </div>
        }
        </div>
    </div>

    @if (_episodes is null)
    {
        <div class="spinner"></div>
    }
    else if (_episodes.Count == 0)
    {
        <p class="empty-message">No episodes found.</p>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th class="col-center">Season</th>
                    <th class="col-center">Episode</th>
                    <th>First Run</th>
                    <th>Duration</th>
                    <th>Title</th>
                    <th>Description</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (EpisodeSummary episode in _episodes)
                {
                    <tr>
                        <td class="col-number col-center">@FormatSeasons(episode.TvdbMatches)</td>
                        <td class="col-number col-center">@FormatEpisodes(episode.TvdbMatches)</td>
                        <td class="col-date">@episode.FirstRun.ToString("yyyy-MM-dd")</td>
                        <td class="col-duration">
                            @((int)Math.Round(episode.Duration.TotalMinutes, MidpointRounding.AwayFromZero))<span class="duration-unit">min</span>
                        </td>
                        <td class="col-copyable">
                            @episode.EpisodeTitle
                            @if (!string.IsNullOrWhiteSpace(episode.EpisodeTitle))
                            {
                                string titleKey = $"{episode.EpisodeRuvId}-title";
                                @if (_copied.Contains(titleKey))
                                {
                                    <span class="icon-button copy-button copy-button--copied">
                                        <Icon Type="IconType.Checkmark" Class="icon" AriaLabel="Copied" />
                                    </span>
                                }
                                else if (_copyFailed.Contains(titleKey))
                                {
                                    <span class="icon-button copy-button copy-button--failed">
                                        <Icon Type="IconType.Warning" Class="icon" AriaLabel="Copy failed" />
                                    </span>
                                }
                                else
                                {
                                    <button class="icon-button copy-button" @onclick="() => CopyToClipboard(episode.EpisodeTitle, titleKey)" title="Copy title">
                                        <Icon Type="IconType.Copy" Class="icon" AriaLabel="Copy" />
                                    </button>
                                }
                            }
                        </td>
                        <td class="col-description col-copyable">
                            @episode.EpisodeDescription
                            @if (!string.IsNullOrWhiteSpace(episode.EpisodeDescription))
                            {
                                string descKey = $"{episode.EpisodeRuvId}-desc";
                                @if (_copied.Contains(descKey))
                                {
                                    <span class="icon-button copy-button copy-button--copied">
                                        <Icon Type="IconType.Checkmark" Class="icon" AriaLabel="Copied" />
                                    </span>
                                }
                                else if (_copyFailed.Contains(descKey))
                                {
                                    <span class="icon-button copy-button copy-button--failed">
                                        <Icon Type="IconType.Warning" Class="icon" AriaLabel="Copy failed" />
                                    </span>
                                }
                                else
                                {
                                    <button class="icon-button copy-button" @onclick="() => CopyToClipboard(episode.EpisodeDescription, descKey)" title="Copy description">
                                        <Icon Type="IconType.Copy" Class="icon" AriaLabel="Copy" />
                                    </button>
                                }
                            }
                        </td>
                        <td>
                            <div class="row-actions">
                                <span title="@(episode.TvdbMatches.Any(m => m.HasIslTranslation) ? "Has Icelandic translation on TVDB" : "No Icelandic translation on TVDB")">
                                    <IcelandicFlag Class="@(episode.TvdbMatches.Any(m => m.HasIslTranslation) ? null : "flag--dimmed")"
                                                   AriaLabel="@(episode.TvdbMatches.Any(m => m.HasIslTranslation) ? "Has Icelandic translation" : "No Icelandic translation")" />
                                </span>
                                @if (episode.TvdbMatches.FirstOrDefault()?.TvdbUrl is { } tvdbUrl)
                                {
                                    <a class="badge--tvdb" href="@tvdbUrl" target="_blank" rel="noopener noreferrer">TVDB</a>
                                }
                                @if (episode.RuvUrl is not null)
                                {
                                    <a class="badge--ruv" href="@episode.RuvUrl" target="_blank" rel="noopener noreferrer">RÚV</a>
                                }
                                @if (_program.SeriesName is not null)
                                {
                                    <button class="icon-button" @onclick="() => OpenMatchDialog(episode.EpisodeRuvId, episode.TvdbMatches, episode.EpisodeTitle)" title="Match to TVDB">
                                        <Icon Type="IconType.LinkDiagonal" Class="icon" AriaLabel="Match to TVDB" />
                                    </button>
                                }
                                @if (_downloading.Contains(episode.EpisodeRuvId))
                                {
                                    <Icon Type="IconType.Spinner" Class="icon icon--spinning" AriaLabel="Queuing" />
                                }
                                else if (_queued.Contains(episode.EpisodeRuvId))
                                {
                                    <Icon Type="IconType.Checkmark" Class="icon" AriaLabel="Queued" />
                                }
                                else if (_failed.Contains(episode.EpisodeRuvId))
                                {
                                    <button class="icon-button icon-button--error" @onclick="() => Download(episode.EpisodeRuvId)" title="Retry">
                                        <Icon Type="IconType.Refresh" Class="icon" AriaLabel="Retry" />
                                    </button>
                                }
                                else
                                {
                                    <button class="icon-button" @onclick="() => Download(episode.EpisodeRuvId)" title="Download">
                                        <Icon Type="IconType.Download" Class="icon" AriaLabel="Download" />
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

<MatchProgramDialog @ref="_matchProgramDialog" OnMatchComplete="ReloadProgramAsync" />
<MatchEpisodeDialog @ref="_matchDialog" OnMatchComplete="ReloadEpisodesAsync" />
<AddToSonarrDialog @ref="_addToSonarrDialog" OnAddComplete="ReloadProgramAsync" />

@code {
    [Parameter]
    public int RuvId { get; set; }

    private ProgramSummary? _program;
    private List<EpisodeSummary>? _episodes;
    private bool _notFound;
    private readonly HashSet<string> _downloading = [];
    private readonly HashSet<string> _queued = [];
    private readonly HashSet<string> _failed = [];
    private readonly HashSet<int> _pendingRefresh = [];
    private readonly HashSet<string> _copied = [];
    private readonly HashSet<string> _copyFailed = [];
    private Dictionary<int, ProgramRefreshStatus> _refreshQueue = [];
    private readonly CancellationTokenSource _cts = new();

    private MatchProgramDialog? _matchProgramDialog;
    private MatchEpisodeDialog? _matchDialog;
    private AddToSonarrDialog? _addToSonarrDialog;
    private DateTime _lastEpisodeReloadTime;
    private DateTime _lastProgramReloadTime;

    protected override async Task OnInitializedAsync()
    {
        _ = WatchDownloadQueueAsync();
        _ = WatchRefreshQueueAsync();
        _ = WatchEpisodeMatchesAsync();
        _ = WatchProgramMatchesAsync();

        await using AsyncServiceScope scope = ScopeFactory.CreateAsyncScope();
        IRequestHandler<GetProgramQuery, ProgramSummary?> programHandler =
            scope.ServiceProvider.GetRequiredService<IRequestHandler<GetProgramQuery, ProgramSummary?>>();
        IRequestHandler<GetProgramEpisodesQuery, List<EpisodeSummary>> episodesHandler =
            scope.ServiceProvider.GetRequiredService<IRequestHandler<GetProgramEpisodesQuery, List<EpisodeSummary>>>();

        Task<ProgramSummary?> programTask = programHandler.Handle(new GetProgramQuery(RuvId), _cts.Token);
        Task<List<EpisodeSummary>> episodesTask = episodesHandler.Handle(new GetProgramEpisodesQuery(RuvId), _cts.Token);

        await Task.WhenAll(programTask, episodesTask);

        _program = await programTask;
        _notFound = _program is null;
        _episodes = await episodesTask;
    }

    private async Task WatchDownloadQueueAsync()
    {
        await foreach (DownloadCompletedEvent _ in Broadcaster.Subscribe<DownloadCompletedEvent>(_cts.Token))
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task WatchRefreshQueueAsync()
    {
        await foreach (QueueChangedEvent<ProgramRefreshQueueItemSummary> _ in Broadcaster.Subscribe<QueueChangedEvent<ProgramRefreshQueueItemSummary>>(_cts.Token))
        {
            _refreshQueue = RefreshNotifier.Items.ToDictionary(x => x.RuvId, x => x.Status);
            foreach (int ruvId in _pendingRefresh.Where(id => _refreshQueue.ContainsKey(id)).ToList())
            {
                _pendingRefresh.Remove(ruvId);
            }
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task WatchEpisodeMatchesAsync()
    {
        await foreach (EpisodeMatchedEvent @event in Broadcaster.Subscribe<EpisodeMatchedEvent>(_cts.Token))
        {
            if (@event.Episode.Program.RuvId != RuvId)
            {
                continue;
            }

            if (DateTime.UtcNow - _lastEpisodeReloadTime < TimeSpan.FromMilliseconds(200))
            {
                continue;
            }

            await Task.Delay(200, _cts.Token);

            if (DateTime.UtcNow - _lastEpisodeReloadTime < TimeSpan.FromMilliseconds(200))
            {
                continue;
            }

            _lastEpisodeReloadTime = DateTime.UtcNow;
            await ReloadEpisodesAsync();
        }
    }

    private async Task WatchProgramMatchesAsync()
    {
        Task tvdbTask = Task.Run(async () =>
        {
            await foreach (ProgramMatchedTvdbEvent @event in Broadcaster.Subscribe<ProgramMatchedTvdbEvent>(_cts.Token))
            {
                if (@event.RuvId != RuvId)
                {
                    continue;
                }

                if (DateTime.UtcNow - _lastProgramReloadTime < TimeSpan.FromMilliseconds(200))
                {
                    continue;
                }

                await Task.Delay(200, _cts.Token);

                if (DateTime.UtcNow - _lastProgramReloadTime < TimeSpan.FromMilliseconds(200))
                {
                    continue;
                }

                _lastProgramReloadTime = DateTime.UtcNow;
                await ReloadProgramDetailsAsync();
            }
        }, _cts.Token);

        Task tmdbTask = Task.Run(async () =>
        {
            await foreach (ProgramMatchedTmdbEvent @event in Broadcaster.Subscribe<ProgramMatchedTmdbEvent>(_cts.Token))
            {
                if (@event.RuvId != RuvId)
                {
                    continue;
                }

                if (DateTime.UtcNow - _lastProgramReloadTime < TimeSpan.FromMilliseconds(200))
                {
                    continue;
                }

                await Task.Delay(200, _cts.Token);

                if (DateTime.UtcNow - _lastProgramReloadTime < TimeSpan.FromMilliseconds(200))
                {
                    continue;
                }

                _lastProgramReloadTime = DateTime.UtcNow;
                await ReloadProgramDetailsAsync();
            }
        }, _cts.Token);

        await Task.WhenAll(tvdbTask, tmdbTask);
    }

    private async Task ReloadProgramDetailsAsync()
    {
        await using AsyncServiceScope scope = ScopeFactory.CreateAsyncScope();
        IRequestHandler<GetProgramQuery, ProgramSummary?> handler =
            scope.ServiceProvider.GetRequiredService<IRequestHandler<GetProgramQuery, ProgramSummary?>>();
        _program = await handler.Handle(new GetProgramQuery(RuvId), _cts.Token);
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        await _cts.CancelAsync();
        _cts.Dispose();
    }

    private async Task ReloadEpisodesAsync()
    {
        _episodes = null;
        await InvokeAsync(StateHasChanged);
        await using AsyncServiceScope scope = ScopeFactory.CreateAsyncScope();
        IRequestHandler<GetProgramEpisodesQuery, List<EpisodeSummary>> handler =
            scope.ServiceProvider.GetRequiredService<IRequestHandler<GetProgramEpisodesQuery, List<EpisodeSummary>>>();
        _episodes = await handler.Handle(new GetProgramEpisodesQuery(RuvId), _cts.Token);
        await InvokeAsync(StateHasChanged);
    }

    [System.Diagnostics.CodeAnalysis.SuppressMessage("Minor Code Smell", "S1144", Justification = "Called from Razor template via @onclick")]
    private async Task Download(string ruvId)
    {
        _downloading.Add(ruvId);

        await using AsyncServiceScope scope = ScopeFactory.CreateAsyncScope();
        IRequestHandler<DownloadEpisodeCommand> handler =
            scope.ServiceProvider.GetRequiredService<IRequestHandler<DownloadEpisodeCommand>>();
        RuvarrResult result = await handler.Handle(new DownloadEpisodeCommand(ruvId), _cts.Token);

        _downloading.Remove(ruvId);

        if (result.IsSuccess)
        {
            _queued.Add(ruvId);
            _ = ClearQueuedAfterDelayAsync(ruvId);
        }
        else
        {
            _failed.Add(ruvId);
        }
    }

    private async Task ClearQueuedAfterDelayAsync(string ruvId)
    {
        try
        {
            await Task.Delay(2000, _cts.Token);
            _queued.Remove(ruvId);
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            // Component disposed, discard the delayed UI update
        }
    }

    [System.Diagnostics.CodeAnalysis.SuppressMessage("Minor Code Smell", "S1144", Justification = "Called from Razor template via @onclick")]
    private async Task RefreshProgram(int ruvId)
    {
        _pendingRefresh.Add(ruvId);
        await using AsyncServiceScope scope = ScopeFactory.CreateAsyncScope();
        IRequestHandler<RefreshProgramCommand> handler =
            scope.ServiceProvider.GetRequiredService<IRequestHandler<RefreshProgramCommand>>();
        await handler.Handle(new RefreshProgramCommand(ruvId), _cts.Token);
    }

    [System.Diagnostics.CodeAnalysis.SuppressMessage("Minor Code Smell", "S1144", Justification = "Called from Razor template via @onclick")]
    private async Task OpenMatchDialog(string ruvId, IReadOnlyList<TvdbEpisodeSummary> currentMatches, string episodeTitle)
    {
        await _matchDialog!.OpenAsync(ruvId, currentMatches, _program!.TvdbSeriesId!.Value, episodeTitle, _episodes!);
    }

    internal static string FormatSeasons(IReadOnlyList<TvdbEpisodeSummary> matches)
    {
        if (matches.Count == 0)
        {
            return string.Empty;
        }

        return string.Join(", ", matches.Select(m => m.SeasonNumber).Distinct().Order());
    }

    internal static string FormatEpisodes(IReadOnlyList<TvdbEpisodeSummary> matches)
    {
        if (matches.Count == 0)
        {
            return string.Empty;
        }

        return string.Join(", ", matches.Select(m => m.EpisodeNumber).Order());
    }

    internal static string GetMatchButtonLabel(int? tvdbSeriesId, bool isMovieMatch)
    {
        return tvdbSeriesId is null && !isMovieMatch ? "Match" : "Fix Match";
    }

    [System.Diagnostics.CodeAnalysis.SuppressMessage("Minor Code Smell", "S1144", Justification = "Called from Razor template via @onclick")]
    private async Task OpenMatchProgramDialog()
    {
        bool isFixMatch = _program!.TvdbSeriesId is not null || _program.IsMovieMatch;
        await _matchProgramDialog!.OpenAsync(_program.ProgramRuvId, _program.TvdbSeriesId, _program.ProgramName, isFixMatch);
    }

    [System.Diagnostics.CodeAnalysis.SuppressMessage("Minor Code Smell", "S1144", Justification = "Called from Razor template via @onclick")]
    private async Task OpenAddToSonarrDialog()
    {
        await _addToSonarrDialog!.OpenAsync(_program!.ProgramRuvId);
    }

    private async Task ReloadProgramAsync()
    {
        await using AsyncServiceScope scope = ScopeFactory.CreateAsyncScope();

        IRequestHandler<RefreshProgramCommand> refreshHandler =
            scope.ServiceProvider.GetRequiredService<IRequestHandler<RefreshProgramCommand>>();
        await refreshHandler.Handle(new RefreshProgramCommand(RuvId), _cts.Token);

        IRequestHandler<GetProgramQuery, ProgramSummary?> handler =
            scope.ServiceProvider.GetRequiredService<IRequestHandler<GetProgramQuery, ProgramSummary?>>();
        _program = await handler.Handle(new GetProgramQuery(RuvId), _cts.Token);
        await InvokeAsync(StateHasChanged);
    }

    [System.Diagnostics.CodeAnalysis.SuppressMessage("Minor Code Smell", "S1144", Justification = "Called from Razor template via @onclick")]
    private async Task CreateOnTvdb()
    {
        string clipboardText = $"Name: {_program!.ProgramName}\nNetwork: RÚV\nRemote ID: {_program.ProgramRuvId} (RÚV)";
        try
        {
            await Js.InvokeAsync<bool>("copyToClipboard", clipboardText);
        }
        catch (JSException)
        {
            // Clipboard access may be denied; still open the page
        }
        await Js.InvokeVoidAsync("open", "https://thetvdb.com/series/create", "_blank");
    }

    [System.Diagnostics.CodeAnalysis.SuppressMessage("Minor Code Smell", "S1144", Justification = "Called from Razor template via @onclick")]
    private async Task CopyToClipboard(string text, string key)
    {
        bool success;
        try
        {
            success = await Js.InvokeAsync<bool>("copyToClipboard", text);
        }
        catch (JSException)
        {
            success = false;
        }

        if (success)
        {
            _copied.Add(key);
            StateHasChanged();
            await ClearAfterDelayAsync(key, _copied);
        }
        else
        {
            _copyFailed.Add(key);
            StateHasChanged();
            await ClearAfterDelayAsync(key, _copyFailed);
        }
    }

    private async Task ClearAfterDelayAsync(string key, HashSet<string> set)
    {
        try
        {
            await Task.Delay(1500, _cts.Token);
            set.Remove(key);
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            // Component disposed, discard the delayed UI update
        }
    }
}
