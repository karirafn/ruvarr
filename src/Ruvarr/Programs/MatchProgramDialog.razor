@namespace Ruvarr.Programs
@using Ruvarr.Abstractions
@using Ruvarr.Contracts
@using Ruvarr.Programs.Commands.MatchProgram
@using Ruvarr.Programs.Queries.SearchTvdbSeries
@implements IAsyncDisposable
@inject IServiceScopeFactory ScopeFactory
@inject IJSRuntime Js

<dialog @ref="_dialog" @onclose="OnDialogClose">
    <h2>@(_isFixMatch ? "Fix Match" : "Match to TVDB")</h2>
    @if (_isLoadingSuggestions)
    {
        <div class="dialog-spinner-container" role="status" aria-label="Loading suggestions">
            <span class="dialog-spinner"></span>
        </div>
    }
    else if (_suggestions.Count > 0)
    {
        <p class="suggestion-label" id="suggestion-label">Suggestions</p>
        <div class="suggestion-list" role="group" aria-labelledby="suggestion-label">
            @foreach (TvdbSeriesSuggestion suggestion in _suggestions)
            {
                <button class="suggestion-item @(IsSuggestionSelected(suggestion.TvdbId, _tvdbIdInput) ? "suggestion-item--selected" : "")"
                        @onclick="() => SelectSuggestion(suggestion)">
                    <span class="suggestion-name">@suggestion.Name</span>
                    <span class="suggestion-meta">@FormatMeta(suggestion)</span>
                </button>
            }
        </div>
    }
    else if (_searchFailed)
    {
        <p class="suggestion-empty">Could not load suggestions</p>
    }
    else if (_suggestions.Count == 0 && !_isLoadingSuggestions && _hasSearched)
    {
        <p class="suggestion-empty">No series found. Try a different search or enter a TVDB Series ID manually below.</p>
    }
    <label class="manual-input-label">
        TVDB Series ID
        <input type="number" min="1" @bind="_tvdbIdInput" @bind:event="oninput" @onkeydown="HandleKeyDown" />
    </label>
    @if (_errorMessage is not null)
    {
        <p class="dialog-error">@_errorMessage</p>
    }
    <div class="dialog-actions">
        <button class="dialog-button dialog-button--primary" @onclick="SubmitMatch" disabled="@IsMatchDisabled(_tvdbIdInput, _currentTvdbSeriesId, _isSubmitting)">
            @if (_isSubmitting)
            {
                <span class="button-spinner"></span>
            }
            Match
        </button>
        <button class="dialog-button" @onclick="CloseAsync" disabled="@_isSubmitting">Cancel</button>
    </div>
</dialog>

@code {
    [Parameter]
    public EventCallback OnMatchComplete { get; set; }

    private ElementReference _dialog;
    private int? _ruvId;
    private string _tvdbIdInput = string.Empty;
    private int? _currentTvdbSeriesId;
    private bool _isFixMatch;
    private bool _isSubmitting;
    private string? _errorMessage;
    private readonly CancellationTokenSource _cts = new();

    private IReadOnlyList<TvdbSeriesSuggestion> _suggestions = [];
    private bool _isLoadingSuggestions;
    private bool _searchFailed;
    private bool _hasSearched;

    public async Task OpenAsync(int ruvId, int? currentTvdbSeriesId, string programName, bool isFixMatch)
    {
        _ruvId = ruvId;
        _isFixMatch = isFixMatch;
        _currentTvdbSeriesId = currentTvdbSeriesId;
        _tvdbIdInput = currentTvdbSeriesId?.ToString() ?? string.Empty;
        _errorMessage = null;
        _suggestions = [];
        _isLoadingSuggestions = true;
        _searchFailed = false;
        _hasSearched = false;
        await InvokeAsync(StateHasChanged);
        await Js.InvokeVoidAsync("showDialog", _dialog);

        await LoadSuggestionsAsync(programName);
    }

    private async Task LoadSuggestionsAsync(string programName)
    {
        try
        {
            await using AsyncServiceScope scope = ScopeFactory.CreateAsyncScope();
            IRequestHandler<SearchTvdbSeriesQuery, IReadOnlyList<TvdbSeriesSuggestion>> handler =
                scope.ServiceProvider.GetRequiredService<IRequestHandler<SearchTvdbSeriesQuery, IReadOnlyList<TvdbSeriesSuggestion>>>();
            _suggestions = await handler.Handle(new SearchTvdbSeriesQuery(programName), _cts.Token);
        }
        catch (Exception)
        {
            _searchFailed = true;
        }
        finally
        {
            _isLoadingSuggestions = false;
            _hasSearched = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    [System.Diagnostics.CodeAnalysis.SuppressMessage("Minor Code Smell", "S1144", Justification = "Called from Razor template via @onclick")]
    private void SelectSuggestion(TvdbSeriesSuggestion suggestion)
    {
        _tvdbIdInput = suggestion.TvdbId.ToString(System.Globalization.CultureInfo.InvariantCulture);
    }

    [System.Diagnostics.CodeAnalysis.SuppressMessage("Minor Code Smell", "S1144", Justification = "Called from Razor template via @onclick")]
    private async Task CloseAsync()
    {
        await Js.InvokeVoidAsync("closeDialog", _dialog);
    }

    private void OnDialogClose()
    {
        _ruvId = null;
        _isFixMatch = false;
        _currentTvdbSeriesId = null;
        _tvdbIdInput = string.Empty;
        _suggestions = [];
        _isLoadingSuggestions = false;
        _searchFailed = false;
        _hasSearched = false;
    }

    [System.Diagnostics.CodeAnalysis.SuppressMessage("Minor Code Smell", "S1144", Justification = "Called from Razor template via @onclick")]
    private async Task SubmitMatch()
    {
        if (_isSubmitting)
        {
            return;
        }

        _isSubmitting = true;
        _errorMessage = null;

        if (_ruvId is null || !int.TryParse(_tvdbIdInput, out int tvdbSeriesId) || tvdbSeriesId <= 0)
        {
            _isSubmitting = false;
            return;
        }

        try
        {
            await using AsyncServiceScope scope = ScopeFactory.CreateAsyncScope();
            IRequestHandler<MatchProgramCommand> handler =
                scope.ServiceProvider.GetRequiredService<IRequestHandler<MatchProgramCommand>>();
            RuvarrResult result = await handler.Handle(new MatchProgramCommand(_ruvId.Value, tvdbSeriesId), _cts.Token);

            if (!result.IsSuccess)
            {
                _errorMessage = result.Error.Description;
                return;
            }
        }
        finally
        {
            _isSubmitting = false;
        }

        await CloseAsync();
        await OnMatchComplete.InvokeAsync();
    }

    [System.Diagnostics.CodeAnalysis.SuppressMessage("Minor Code Smell", "S1144", Justification = "Called from Razor template via @onkeydown")]
    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !IsMatchDisabled(_tvdbIdInput, _currentTvdbSeriesId, _isSubmitting))
        {
            await SubmitMatch();
        }
    }

    public async ValueTask DisposeAsync()
    {
        await _cts.CancelAsync();
        _cts.Dispose();
    }

    internal static bool IsMatchDisabled(string input, int? currentTvdbSeriesId, bool isSubmitting)
    {
        if (isSubmitting)
        {
            return true;
        }

        if (!int.TryParse(input, out int parsed) || parsed <= 0)
        {
            return true;
        }

        return parsed == currentTvdbSeriesId;
    }

    internal static bool IsSuggestionSelected(int tvdbId, string tvdbIdInput)
    {
        return int.TryParse(tvdbIdInput, out int parsed) && parsed == tvdbId;
    }

    private static string FormatMeta(TvdbSeriesSuggestion suggestion)
    {
        string parts = suggestion.Year is not null
            ? $"{suggestion.Year} \u00b7 TVDB {suggestion.TvdbId}"
            : $"TVDB {suggestion.TvdbId}";
        return parts;
    }
}
