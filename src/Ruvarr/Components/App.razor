<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ruvarr</title>
    <base href="/" />
    <link rel="stylesheet" href="app.css" @@fingerprint />
    <link rel="stylesheet" href="Ruvarr.styles.css" @@fingerprint />
</head>
<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
    <script>
        window.showDialog = (el) => el.showModal();
        window.closeDialog = (el) => el.close();
        window.copyToClipboard = async (text) => {
            try {
                if (navigator.clipboard && window.isSecureContext) {
                    await navigator.clipboard.writeText(text);
                    return true;
                }
                const textarea = document.createElement('textarea');
                textarea.value = text;
                textarea.setAttribute('aria-hidden', 'true');
                textarea.style.position = 'fixed';
                textarea.style.left = '-9999px';
                document.body.appendChild(textarea);
                textarea.select();
                const success = document.execCommand('copy');
                document.body.removeChild(textarea);
                return success;
            } catch {
                return false;
            }
        };
        window.focusElement = (el) => { if (el) el.focus(); };
        window._trackedScrollY = 0;
        window._scrollTracker = null;
        window.startScrollTracking = () => {
            window._trackedScrollY = window.scrollY;
            if (!window._scrollTracker) {
                window._scrollTracker = () => { window._trackedScrollY = window.scrollY; };
                window.addEventListener('scroll', window._scrollTracker, { passive: true });
            }
        };
        window.stopScrollTracking = () => {
            if (window._scrollTracker) {
                window.removeEventListener('scroll', window._scrollTracker);
                window._scrollTracker = null;
            }
            return window._trackedScrollY;
        };
        window.setScrollY = (y) => {
            if (y <= 0) return;
            const scroll = () => window.scrollTo(0, y);
            scroll();
            requestAnimationFrame(scroll);
            setTimeout(scroll, 150);
            setTimeout(scroll, 400);
        };
        document.addEventListener('mousedown', (e) => {
            if (e.target.closest('a[href]:not([target])') && window._scrollTracker) {
                window._trackedScrollY = window.scrollY;
                window.removeEventListener('scroll', window._scrollTracker);
                window._scrollTracker = null;
            }
        }, { capture: true });
    </script>
</body>
</html>
