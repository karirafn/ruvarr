@inherits LayoutComponentBase
@inject Ruvarr.Settings.ISettingsStore SettingsStore
@inject NavigationManager Navigation
@implements IDisposable

<div class="layout @(_drawerOpen ? "layout--drawer-open" : "")"
     tabindex="-1"
     @onkeydown="OnKeyDown">

    <header class="mobile-topbar">
        <button class="hamburger-button"
                @onclick="ToggleDrawer"
                aria-label="Toggle navigation"
                aria-expanded="@(_drawerOpen ? "true" : "false")">
            <svg class="hamburger-icon" viewBox="0 0 20 16" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <line x1="0" y1="2" x2="20" y2="2" />
                <line x1="0" y1="8" x2="20" y2="8" />
                <line x1="0" y1="14" x2="20" y2="14" />
            </svg>
        </button>
        <span class="mobile-topbar__title">Ruvarr</span>
    </header>

    <div class="nav-backdrop" @onclick="CloseDrawer"></div>

    <NavMenu />

    <main>
        @if (!SettingsStore.Current.IsReady)
        {
            <div class="setup-banner" role="status">
                <svg class="setup-banner__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10" />
                    <line x1="12" y1="16" x2="12" y2="12" />
                    <line x1="12" y1="8" x2="12.01" y2="8" />
                </svg>
                <span>Ruvarr requires configuration before it can run.</span>
                <a class="setup-banner__link" href="/settings">Go to Settings</a>
            </div>
        }
        @Body
    </main>
</div>

@code {
    private Timer? _pollingTimer;
    private bool _drawerOpen;

    protected override void OnInitialized()
    {
        _pollingTimer = new Timer(_ => InvokeAsync(StateHasChanged), null, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(2));
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private void CloseDrawer() => _drawerOpen = false;

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _drawerOpen = false;
        InvokeAsync(StateHasChanged);
    }

    private void OnKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _drawerOpen = false;
        }
    }

    public void Dispose()
    {
        _pollingTimer?.Dispose();
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
