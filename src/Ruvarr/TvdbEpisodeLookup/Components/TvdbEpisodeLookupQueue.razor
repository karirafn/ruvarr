@page "/tvdb-episode-lookup-queue"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@namespace Ruvarr.TvdbEpisodeLookup.Components
@using Ruvarr.Abstractions
@using Ruvarr.Contracts
@using Ruvarr.TvdbEpisodeLookup.Notifiers
@inject TvdbEpisodeLookupNotifier LookupNotifier
@inject IDomainEventBroadcaster Broadcaster
@implements IAsyncDisposable

<h1>TVDB Episode Lookup Queue</h1>

@if (_items is null)
{
    <div class="spinner"></div>
}
else if (_items.Count == 0)
{
    <p>No programs pending TVDB episode lookup.</p>
}
else
{
    <table class="queue-table sync-queue-table">
        <thead>
            <tr>
                <th>Program</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (TvdbEpisodeLookupQueueItemSummary item in _items)
            {
                <tr>
                    <td>@item.ProgramName</td>
                    <td class="queue-status queue-status--@item.Status.ToString().ToLowerInvariant()">
                        @switch (item.Status)
                        {
                            case TvdbEpisodeLookupStatus.Pending:
                                <svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-label="Pending">
                                    <circle cx="12" cy="12" r="10" />
                                    <polyline points="12 6 12 12 16 14" />
                                </svg>
                                break;
                            case TvdbEpisodeLookupStatus.Processing:
                                <svg class="icon icon--spinning" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-label="Processing">
                                    <path d="M21 12a9 9 0 1 1-6.219-8.56" />
                                </svg>
                                break;
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IReadOnlyList<TvdbEpisodeLookupQueueItemSummary>? _items;
    private readonly CancellationTokenSource _cts = new();

    protected override Task OnInitializedAsync()
    {
        _ = WatchAsync();
        return Task.CompletedTask;
    }

    private async Task WatchAsync()
    {
        _items = LookupNotifier.Items;
        await InvokeAsync(StateHasChanged);

        await foreach (QueueChangedEvent<TvdbEpisodeLookupQueueItemSummary> _ in Broadcaster.Subscribe<QueueChangedEvent<TvdbEpisodeLookupQueueItemSummary>>(_cts.Token))
        {
            _items = LookupNotifier.Items;
            await InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync()
    {
        await _cts.CancelAsync();
        _cts.Dispose();
    }
}
