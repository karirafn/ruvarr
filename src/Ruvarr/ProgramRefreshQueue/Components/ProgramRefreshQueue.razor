@page "/program-refresh-queue"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@namespace Ruvarr.ProgramRefreshQueue.Components
@using Ruvarr.Abstractions
@using Ruvarr.Contracts
@using Ruvarr.ProgramRefreshQueue.Notifiers
@inject ProgramRefreshNotifier RefreshNotifier
@inject IDomainEventBroadcaster Broadcaster
@implements IAsyncDisposable

<h1>Program Refresh Queue</h1>

@if (_items is null)
{
    <div class="spinner"></div>
}
else if (_items.Count == 0)
{
    <p>No programs pending refresh.</p>
}
else
{
    <table class="queue-table sync-queue-table">
        <thead>
            <tr>
                <th>Program</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (ProgramRefreshQueueItemSummary item in _items)
            {
                <tr>
                    <td>@item.ProgramName</td>
                    <td class="queue-status queue-status--@item.Status.ToString().ToLowerInvariant()">
                        @switch (item.Status)
                        {
                            case ProgramRefreshStatus.Pending:
                                <Icon Type="IconType.Clock" Class="icon" AriaLabel="Pending" />
                                break;
                            case ProgramRefreshStatus.Processing:
                                <Icon Type="IconType.Spinner" Class="icon icon--spinning" AriaLabel="Processing" />
                                break;
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IReadOnlyList<ProgramRefreshQueueItemSummary>? _items;
    private readonly CancellationTokenSource _cts = new();

    protected override Task OnInitializedAsync()
    {
        _ = WatchAsync();
        return Task.CompletedTask;
    }

    private async Task WatchAsync()
    {
        _items = RefreshNotifier.Items;
        await InvokeAsync(StateHasChanged);

        await foreach (QueueChangedEvent<ProgramRefreshQueueItemSummary> _ in Broadcaster.Subscribe<QueueChangedEvent<ProgramRefreshQueueItemSummary>>(_cts.Token))
        {
            _items = RefreshNotifier.Items;
            await InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync()
    {
        await _cts.CancelAsync();
        _cts.Dispose();
    }
}
