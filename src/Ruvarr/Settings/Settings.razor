@page "/settings"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Ruvarr.Abstractions
@using Ruvarr.Settings.Commands.SaveSettings
@using Ruvarr.Settings.Queries.GetDistinctChannels
@using Ruvarr.Settings.Queries.GetSettings
@using Ruvarr.Settings.Queries.TestSonarrConnection
@inject IServiceScopeFactory ScopeFactory
@inject ISettingsStore SettingsStore
@implements IDisposable

<h1>Settings</h1>

@if (_loading)
{
    <div class="spinner" role="status" aria-label="Loading settings"></div>
}
else
{
    <div class="settings">
        <section class="settings-section">
            <h2 class="settings-section-title">Sonarr</h2>

            <div class="settings-field">
                <label for="sonarr-base-url">Base URL</label>
                <input id="sonarr-base-url" type="url" @bind="_sonarrBaseAddress" aria-describedby="sonarr-base-url-error" />
                @if (_fieldErrors.TryGetValue(SettingsErrors.InvalidSonarrBaseAddressCode, out string? baseUrlError))
                {
                    <span id="sonarr-base-url-error" class="field-error" role="alert">@baseUrlError</span>
                }
            </div>

            <div class="settings-field">
                <label for="sonarr-api-key">Sonarr API Key</label>
                <input id="sonarr-api-key" type="password" @bind="_sonarrApiKey" />
            </div>

            <div class="settings-field">
                <button class="test-button" @onclick="TestConnection" disabled="@_isTesting" aria-busy="@_isTesting">
                    @if (_isTesting)
                    {
                        <span class="button-spinner"></span>
                    }
                    Test Connection
                </button>
                @if (_testResult is not null)
                {
                    @if (_testResult.IsSuccess)
                    {
                        <span class="test-result test-result--success" role="status">Connection successful</span>
                    }
                    else
                    {
                        <span class="test-result test-result--failure" role="alert">@_testResult.Error.Description</span>
                    }
                }
            </div>
        </section>

        <section class="settings-section">
            <h2 class="settings-section-title">TVDB</h2>

            <div class="settings-field">
                <label for="tvdb-api-key">TVDB API Key</label>
                <input id="tvdb-api-key" type="password" @bind="_tvdbApiKey" aria-describedby="tvdb-api-key-error" />
                @if (_fieldErrors.TryGetValue(SettingsErrors.InvalidTvdbApiKeyCode, out string? tvdbApiKeyError))
                {
                    <span id="tvdb-api-key-error" class="field-error" role="alert">@tvdbApiKeyError</span>
                }
            </div>
        </section>

        <section class="settings-section">
            <h2 class="settings-section-title">TMDB</h2>

            <div class="settings-field">
                <label for="tmdb-api-key">TMDB API Key</label>
                <input id="tmdb-api-key" type="password" @bind="_tmdbApiKey" aria-describedby="tmdb-api-key-error" />
                @if (_fieldErrors.TryGetValue(SettingsErrors.InvalidTmdbApiKeyCode, out string? tmdbApiKeyError))
                {
                    <span id="tmdb-api-key-error" class="field-error" role="alert">@tmdbApiKeyError</span>
                }
            </div>
        </section>

        <section class="settings-section">
            <h2 class="settings-section-title">Directories</h2>

            <div class="settings-field">
                <label for="episode-download-dir">Episode Subdirectory</label>
                <input id="episode-download-dir" type="text" @bind="_episodeDownloadDirectory" @bind:event="oninput" aria-describedby="episode-download-dir-resolved episode-download-dir-error" />
                @{ var episodeTrimmed = _episodeDownloadDirectory.Trim('/'); }
                <span id="episode-download-dir-resolved" class="resolved-path">@(string.IsNullOrEmpty(episodeTrimmed) ? SettingsStore.Current.DownloadsRoot : System.IO.Path.Join(SettingsStore.Current.DownloadsRoot, episodeTrimmed))</span>
                @{
                    string? episodeDirError = null;
                    if (_fieldErrors.TryGetValue(SettingsErrors.EpisodeSubdirectoryAbsoluteCode, out string? e1))
                    {
                        episodeDirError = e1;
                    }
                    else if (_fieldErrors.TryGetValue(SettingsErrors.EpisodeSubdirectoryEmptyCode, out string? e2))
                    {
                        episodeDirError = e2;
                    }
                    else if (_fieldErrors.TryGetValue(SettingsErrors.EpisodeSubdirectoryTraversalCode, out string? e3))
                    {
                        episodeDirError = e3;
                    }
                }
                @if (episodeDirError is not null)
                {
                    <span id="episode-download-dir-error" class="field-error" role="alert">@episodeDirError</span>
                }
            </div>

            <div class="settings-field">
                <label for="movie-download-dir">Movie Subdirectory</label>
                <input id="movie-download-dir" type="text" @bind="_movieDownloadDirectory" @bind:event="oninput" aria-describedby="movie-download-dir-resolved movie-download-dir-error" />
                @{ var movieTrimmed = _movieDownloadDirectory.Trim('/'); }
                <span id="movie-download-dir-resolved" class="resolved-path">@(string.IsNullOrEmpty(movieTrimmed) ? SettingsStore.Current.DownloadsRoot : System.IO.Path.Join(SettingsStore.Current.DownloadsRoot, movieTrimmed))</span>
                @{
                    string? movieDirError = null;
                    if (_fieldErrors.TryGetValue(SettingsErrors.MovieSubdirectoryAbsoluteCode, out string? m1))
                    {
                        movieDirError = m1;
                    }
                    else if (_fieldErrors.TryGetValue(SettingsErrors.MovieSubdirectoryEmptyCode, out string? m2))
                    {
                        movieDirError = m2;
                    }
                    else if (_fieldErrors.TryGetValue(SettingsErrors.MovieSubdirectoryTraversalCode, out string? m3))
                    {
                        movieDirError = m3;
                    }
                }
                @if (movieDirError is not null)
                {
                    <span id="movie-download-dir-error" class="field-error" role="alert">@movieDirError</span>
                }
            </div>
        </section>

        <section class="settings-section">
            <h2 class="settings-section-title">Ignored Channels</h2>

            <div class="channel-tags" role="list">
                @foreach (string channel in _ignoredChannelsList)
                {
                    <span class="channel-tag" role="listitem">
                        @channel
                        <button class="channel-tag-remove"
                                aria-label="Remove @channel"
                                @onclick="() => RemoveChannel(channel)">
                            &times;
                        </button>
                    </span>
                }
            </div>

            <div class="channel-add-row">
                <select aria-label="Available channels"
                        @bind="_selectedChannel"
                        disabled="@(!_availableChannels.Any())">
                    <option value="" disabled selected>Select a channel...</option>
                    @foreach (string channel in _availableChannels)
                    {
                        <option value="@channel">@channel</option>
                    }
                </select>
                <button class="add-channel-button"
                        @onclick="AddChannel"
                        disabled="@(string.IsNullOrEmpty(_selectedChannel) || !_availableChannels.Any())">
                    Add
                </button>
            </div>
        </section>

        <div class="settings-actions">
            @if (_confirmingSave)
            {
                <span class="save-warning" role="alert">Programs for newly ignored channels will be permanently deleted.</span>
                <button class="save-button save-button--danger" @onclick="ConfirmSave" disabled="@_isSaving" aria-busy="@_isSaving">
                    @if (_isSaving)
                    {
                        <span class="button-spinner"></span>
                    }
                    Confirm Save
                </button>
                <button class="cancel-button" @onclick="CancelSave">
                    Cancel
                </button>
            }
            else
            {
                <button class="save-button" @onclick="SaveSettings" disabled="@_isSaving" aria-busy="@_isSaving">
                    @if (_isSaving)
                    {
                        <span class="button-spinner"></span>
                    }
                    Save Settings
                </button>
            }
            @if (_showSaveConfirmation)
            {
                <span class="save-confirmation" role="status">Settings saved successfully</span>
            }
        </div>
    </div>
}

@code {
    private readonly CancellationTokenSource _cts = new();
    private bool _loading = true;
    private bool _isSaving;
    private bool _isTesting;
    private bool _showSaveConfirmation;
    private bool _confirmingSave;
    private string _selectedChannel = "";
    private List<string> _allChannels = [];
    private List<string> _availableChannels = [];
    private RuvarrResult? _testResult;
    private Dictionary<string, string> _fieldErrors = [];

    private string _sonarrBaseAddress = string.Empty;
    private string _sonarrApiKey = string.Empty;
    private string _tvdbApiKey = string.Empty;
    private string _tmdbApiKey = string.Empty;
    private string _episodeDownloadDirectory = string.Empty;
    private string _movieDownloadDirectory = string.Empty;
    private List<string> _ignoredChannelsList = [];
    private HashSet<string> _originalIgnoredChannels = new(StringComparer.OrdinalIgnoreCase);
    protected override async Task OnInitializedAsync()
    {
        await using AsyncServiceScope scope = ScopeFactory.CreateAsyncScope();
        IRequestHandler<GetSettingsQuery, Result<RuvarrSettings>> settingsHandler =
            scope.ServiceProvider.GetRequiredService<IRequestHandler<GetSettingsQuery, Result<RuvarrSettings>>>();

        Result<RuvarrSettings> result = await settingsHandler.Handle(new GetSettingsQuery(), _cts.Token);

        if (result.IsSuccess)
        {
            RuvarrSettings settings = result.FromResult();
            _sonarrBaseAddress = settings.SonarrBaseAddress;
            _sonarrApiKey = settings.SonarrApiKey;
            _tvdbApiKey = settings.TvdbApiKey;
            _tmdbApiKey = settings.TmdbApiKey;
            _episodeDownloadDirectory = settings.EpisodeDownloadDirectory;
            _movieDownloadDirectory = settings.MovieDownloadDirectory;
            _ignoredChannelsList = [.. settings.IgnoredChannels];
            _originalIgnoredChannels = new HashSet<string>(settings.IgnoredChannels, StringComparer.OrdinalIgnoreCase);
        }

        IRequestHandler<GetDistinctChannelsQuery, List<string>> channelsHandler =
            scope.ServiceProvider.GetRequiredService<IRequestHandler<GetDistinctChannelsQuery, List<string>>>();
        _allChannels = await channelsHandler.Handle(new GetDistinctChannelsQuery(), _cts.Token);
        _allChannels = _allChannels
            .Union(_ignoredChannelsList, StringComparer.OrdinalIgnoreCase)
            .OrderBy(c => c)
            .ToList();
        UpdateAvailableChannels();

        _loading = false;
    }

    [System.Diagnostics.CodeAnalysis.SuppressMessage("Minor Code Smell", "S1144", Justification = "Called from Razor template via @onclick")]
    private void SaveSettings()
    {
        if (_isSaving)
        {
            return;
        }

        bool hasNewlyIgnored = _ignoredChannelsList.Exists(
            c => !_originalIgnoredChannels.Contains(c));

        if (hasNewlyIgnored)
        {
            _confirmingSave = true;
            return;
        }

        _ = ExecuteSaveAsync();
    }

    [System.Diagnostics.CodeAnalysis.SuppressMessage("Minor Code Smell", "S1144", Justification = "Called from Razor template via @onclick")]
    private async Task ConfirmSave()
    {
        _confirmingSave = false;
        await ExecuteSaveAsync();
    }

    [System.Diagnostics.CodeAnalysis.SuppressMessage("Minor Code Smell", "S1144", Justification = "Called from Razor template via @onclick")]
    private void CancelSave()
    {
        _confirmingSave = false;
    }

    private async Task ExecuteSaveAsync()
    {
        _isSaving = true;
        _fieldErrors = [];
        _showSaveConfirmation = false;

        Uri sonarrUri = Uri.TryCreate(_sonarrBaseAddress, UriKind.Absolute, out Uri? parsed)
            ? parsed
            : new Uri(_sonarrBaseAddress, UriKind.Relative);

        SaveSettingsCommand command = new(
            sonarrUri,
            _sonarrApiKey,
            _tvdbApiKey,
            _tmdbApiKey,
            _episodeDownloadDirectory,
            _movieDownloadDirectory,
            _ignoredChannelsList);

        await using AsyncServiceScope scope = ScopeFactory.CreateAsyncScope();
        IRequestHandler<SaveSettingsCommand> handler =
            scope.ServiceProvider.GetRequiredService<IRequestHandler<SaveSettingsCommand>>();
        RuvarrResult result = await handler.Handle(command, _cts.Token);

        _isSaving = false;

        if (result.IsFailure)
        {
            _fieldErrors[result.Error.Code] = result.Error.Description;
            return;
        }

        _originalIgnoredChannels = new HashSet<string>(_ignoredChannelsList, StringComparer.OrdinalIgnoreCase);
        _showSaveConfirmation = true;
        StateHasChanged();

        try
        {
            await Task.Delay(3000, _cts.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        _showSaveConfirmation = false;
    }

    [System.Diagnostics.CodeAnalysis.SuppressMessage("Minor Code Smell", "S1144", Justification = "Called from Razor template via @onclick")]
    private async Task TestConnection()
    {
        if (_isTesting)
        {
            return;
        }

        _isTesting = true;
        _testResult = null;

        TestSonarrConnectionQuery query = new(_sonarrBaseAddress, _sonarrApiKey, UseStoredApiKey: _sonarrApiKey == "****");

        await using AsyncServiceScope scope = ScopeFactory.CreateAsyncScope();
        IRequestHandler<TestSonarrConnectionQuery> handler =
            scope.ServiceProvider.GetRequiredService<IRequestHandler<TestSonarrConnectionQuery>>();
        _testResult = await handler.Handle(query, _cts.Token);

        _isTesting = false;
    }

    [System.Diagnostics.CodeAnalysis.SuppressMessage("Minor Code Smell", "S1144", Justification = "Called from Razor template via @onclick")]
    private void AddChannel()
    {
        if (string.IsNullOrEmpty(_selectedChannel))
        {
            return;
        }

        _ignoredChannelsList.Add(_selectedChannel);
        _selectedChannel = "";
        UpdateAvailableChannels();
    }

    [System.Diagnostics.CodeAnalysis.SuppressMessage("Minor Code Smell", "S1144", Justification = "Called from Razor template via @onclick")]
    private void RemoveChannel(string channel)
    {
        _ignoredChannelsList.Remove(channel);
        UpdateAvailableChannels();
    }

    private void UpdateAvailableChannels()
    {
        HashSet<string> ignored = new(_ignoredChannelsList, StringComparer.OrdinalIgnoreCase);
        _availableChannels = _allChannels
            .Where(c => !ignored.Contains(c))
            .ToList();
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
