@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@namespace Ruvarr.Dashboard.Components
@implements IAsyncDisposable
@using Ruvarr.Abstractions
@using Ruvarr.Contracts
@using Ruvarr.Dashboard.Queries.GetDashboard
@using Ruvarr.Downloads.Events
@using Ruvarr.Programs.Events
@inject IServiceScopeFactory ScopeFactory
@inject IDomainEventBroadcaster Broadcaster

<h1>Dashboard</h1>

@if (_data is null)
{
    <div class="spinner" role="status" aria-label="Loading"></div>
}
else
{
    <section class="stat-row stat-row--programs" aria-label="Program Statistics">
        <h2 class="stat-row__title">Programs</h2>
        <dl class="stat-row__grid">
            <div class="stat-row__card">
                <dt>Total</dt>
                <dd>@_data.Statistics.Programs.Total</dd>
            </div>
            <div class="stat-row__card">
                <dt>Monitored</dt>
                <dd>@_data.Statistics.Programs.Monitored</dd>
            </div>
            <div class="stat-row__card">
                <dt>Matched</dt>
                <dd>@_data.Statistics.Programs.Matched</dd>
            </div>
            <div class="stat-row__card">
                <dt>Missing Episodes</dt>
                <dd>@_data.Statistics.Programs.WithMissingEpisodes</dd>
            </div>
        </dl>
    </section>

    <section class="stat-row stat-row--episodes" aria-label="Episode Statistics">
        <h2 class="stat-row__title">Episodes</h2>
        <dl class="stat-row__grid">
            <div class="stat-row__card">
                <dt>Total</dt>
                <dd>@_data.Statistics.Episodes.Total</dd>
            </div>
            <div class="stat-row__card">
                <dt>Matched</dt>
                <dd>@_data.Statistics.Episodes.Matched</dd>
            </div>
            <div class="stat-row__card">
                <dt>Unmatched</dt>
                <dd>@_data.Statistics.Episodes.Unmatched</dd>
            </div>
            <div class="stat-row__card">
                <dt>No Translation</dt>
                <dd>@_data.Statistics.Episodes.WithoutTranslation</dd>
            </div>
        </dl>
    </section>

    <section class="stat-row stat-row--downloads" aria-label="Download Statistics">
        <h2 class="stat-row__title">Downloads</h2>
        <dl class="stat-row__grid">
            <div class="stat-row__card">
                <dt>Queue</dt>
                <dd>@_data.Statistics.Downloads.QueueDepth</dd>
            </div>
            <div class="stat-row__card">
                <dt>Downloading</dt>
                <dd>@_data.Statistics.Downloads.Downloading</dd>
            </div>
            <div class="stat-row__card">
                <dt>Completed (7d)</dt>
                <dd>@_data.Statistics.Downloads.CompletedLast7Days</dd>
            </div>
            <div class="stat-row__card">
                <dt>Failed</dt>
                <dd>@_data.Statistics.Downloads.Failed</dd>
            </div>
        </dl>
    </section>

    <section class="refresh-card" aria-label="Program Refresh">
        <div class="refresh-card__header">
            <h2 class="dashboard-section-title">Program Refresh</h2>
            @if (_data.ProgramRefresh.IsRunning)
            {
                <span class="refresh-card__badge refresh-card__badge--running">
                    <Icon Type="IconType.Spinner" Class="icon icon--spinning" AriaLabel="Running" />
                    Running
                </span>
            }
            else
            {
                <span class="refresh-card__badge refresh-card__badge--idle">
                    <Icon Type="IconType.Clock" Class="icon" AriaLabel="Idle" />
                    Idle
                </span>
            }
        </div>

        @if (_data.ProgramRefresh.IsRunning)
        {
            <div class="refresh-card__progress-track" role="progressbar"
                 aria-label="Program refresh progress"
                 aria-valuenow="@((int)GetProgressPercent(_data.ProgramRefresh))"
                 aria-valuemin="0" aria-valuemax="100">
                <div class="refresh-card__progress-bar" style="width:@(GetProgressPercent(_data.ProgramRefresh).ToString("F0", System.Globalization.CultureInfo.InvariantCulture))%"></div>
            </div>
            <div class="refresh-card__running-details" aria-live="polite">
                <span class="refresh-card__count">@_data.ProgramRefresh.CompletedCount / @(_data.ProgramRefresh.CompletedCount + _data.ProgramRefresh.Depth)</span>
                @if (_data.ProgramRefresh.CurrentProgram is not null)
                {
                    <span class="refresh-card__current">@_data.ProgramRefresh.CurrentProgram</span>
                }
                @{ TimeSpan? eta = GetEta(_data.ProgramRefresh); }
                @if (eta is not null)
                {
                    <span class="refresh-card__eta">ETA @FormatDuration(eta.Value)</span>
                }
            </div>
        }
        else
        {
            <dl class="refresh-card__details">
                <div class="refresh-card__detail">
                    <dt>Last completed</dt>
                    <dd>@FormatTimestamp(_data.ProgramRefresh.LastCompletedAt)</dd>
                </div>
                <div class="refresh-card__detail">
                    <dt>Duration</dt>
                    <dd>@(_data.ProgramRefresh.LastRunDuration is not null ? FormatDuration(_data.ProgramRefresh.LastRunDuration.Value) : "—")</dd>
                </div>
                <div class="refresh-card__detail">
                    <dt>Programs</dt>
                    <dd>@(_data.ProgramRefresh.LastRunTotal?.ToString() ?? "—")</dd>
                </div>
                <div class="refresh-card__detail">
                    <dt>Next run</dt>
                    <dd>@FormatNextRun(_data.ProgramRefresh.NextFireTimeUtc)</dd>
                </div>
            </dl>
        }
    </section>

    <section class="dashboard-section" aria-label="Recently Added Episodes">
        <h2 class="dashboard-section-title">Recently Added Episodes</h2>
        @if (_data.RecentlyAddedEpisodes.Count == 0)
        {
            <p class="empty-message">No recently added episodes.</p>
        }
        else
        {
            <table class="dashboard-table">
                <thead>
                    <tr>
                        <th>Program</th>
                        <th>Episode</th>
                        <th>First Run</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (DashboardEpisodeItem episode in _data.RecentlyAddedEpisodes)
                    {
                        <tr>
                            <td><a class="program-link" href="/program/@episode.ProgramRuvId">@episode.ProgramName</a></td>
                            <td>@episode.EpisodeTitle</td>
                            <td>@episode.FirstRun.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <section class="dashboard-section" aria-label="Requires Translation">
        <h2 class="dashboard-section-title">Requires Translation</h2>
        @if (_data.RequiresTranslationEpisodes.Count == 0)
        {
            <p class="empty-message">All matched episodes have Icelandic translations.</p>
        }
        else
        {
            <table class="dashboard-table">
                <thead>
                    <tr>
                        <th>Program</th>
                        <th>Episode</th>
                        <th>First Run</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (DashboardEpisodeItem episode in _data.RequiresTranslationEpisodes)
                    {
                        <tr>
                            <td><a class="program-link" href="/program/@episode.ProgramRuvId">@episode.ProgramName</a></td>
                            <td>@episode.EpisodeTitle</td>
                            <td>@episode.FirstRun.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <section class="dashboard-section" aria-label="Likely Downloaded Once Matched">
        <h2 class="dashboard-section-title">Likely Downloaded Once Matched</h2>
        @if (_data.LikelyDownloadedOnceMatchedEpisodes.Count == 0)
        {
            <p class="empty-message">No unmatched episodes on monitored programs.</p>
        }
        else
        {
            <table class="dashboard-table">
                <thead>
                    <tr>
                        <th>Program</th>
                        <th>Episode</th>
                        <th>First Run</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (DashboardEpisodeItem episode in _data.LikelyDownloadedOnceMatchedEpisodes)
                    {
                        <tr>
                            <td><a class="program-link" href="/program/@episode.ProgramRuvId">@episode.ProgramName</a></td>
                            <td>@episode.EpisodeTitle</td>
                            <td>@episode.FirstRun.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
}

@code {
    private const int DebounceDelayMs = 500;

    private DashboardData? _data;
    private readonly CancellationTokenSource _cts = new();
    private CancellationTokenSource? _debounceTokenSource;

    protected override Task OnInitializedAsync()
    {
        _ = LoadDataAsync();
        _ = WatchAsync(Broadcaster.Subscribe<ProgramCreatedEvent>(_cts.Token));
        _ = WatchAsync(Broadcaster.Subscribe<ProgramMatchedTvdbEvent>(_cts.Token));
        _ = WatchAsync(Broadcaster.Subscribe<ProgramMatchedTmdbEvent>(_cts.Token));
        _ = WatchAsync(Broadcaster.Subscribe<EpisodeMatchedEvent>(_cts.Token));
        _ = WatchAsync(Broadcaster.Subscribe<DownloadStartedEvent>(_cts.Token));
        _ = WatchAsync(Broadcaster.Subscribe<DownloadCompletedEvent>(_cts.Token));
        _ = WatchAsync(Broadcaster.Subscribe<QueueChangedEvent<ProgramRefreshQueueItemSummary>>(_cts.Token));
        _ = WatchAsync(Broadcaster.Subscribe<QueueChangedEvent<TvdbSeriesLookupQueueItemSummary>>(_cts.Token));
        _ = WatchAsync(Broadcaster.Subscribe<QueueChangedEvent<TvdbEpisodeLookupQueueItemSummary>>(_cts.Token));
        return Task.CompletedTask;
    }

    private async Task LoadDataAsync()
    {
        await using AsyncServiceScope scope = ScopeFactory.CreateAsyncScope();
        IRequestHandler<GetDashboardQuery, DashboardData> handler =
            scope.ServiceProvider.GetRequiredService<IRequestHandler<GetDashboardQuery, DashboardData>>();
        _data = await handler.Handle(new GetDashboardQuery(), _cts.Token);
        await InvokeAsync(StateHasChanged);
    }

    private async Task WatchAsync<T>(IAsyncEnumerable<T> events) where T : class
    {
        await foreach (T _ in events)
        {
            await DebouncedLoadDataAsync();
        }
    }

    private async Task DebouncedLoadDataAsync()
    {
        if (_debounceTokenSource is not null)
        {
            await _debounceTokenSource.CancelAsync();
            _debounceTokenSource.Dispose();
        }
        _debounceTokenSource = new CancellationTokenSource();

        try
        {
            await Task.Delay(DebounceDelayMs, _debounceTokenSource.Token);
            await LoadDataAsync();
        }
        catch (OperationCanceledException)
        {
            // Debounce reset or component disposed, discard
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_debounceTokenSource is not null)
        {
            await _debounceTokenSource.CancelAsync();
            _debounceTokenSource.Dispose();
        }
        await _cts.CancelAsync();
        _cts.Dispose();
    }

    private static double GetProgressPercent(ProgramRefreshCardInfo info)
    {
        int total = info.CompletedCount + info.Depth;
        return total == 0 ? 0 : (double)info.CompletedCount / total * 100;
    }

    private static TimeSpan? GetEta(ProgramRefreshCardInfo info)
    {
        if (!info.IsRunning || info.LastRunDuration is null)
        {
            return null;
        }

        int total = info.CompletedCount + info.Depth;
        if (total == 0)
        {
            return null;
        }

        double remaining = 1.0 - (double)info.CompletedCount / total;
        return info.LastRunDuration.Value * remaining;
    }

    private static string FormatDuration(TimeSpan duration)
    {
        if (duration.TotalHours >= 1)
        {
            return $"{(int)duration.TotalHours}h {duration.Minutes:D2}m";
        }

        if (duration.TotalMinutes >= 1)
        {
            return $"{(int)duration.TotalMinutes}m {duration.Seconds:D2}s";
        }

        return $"{(int)duration.TotalSeconds}s";
    }

    private static string FormatTimestamp(DateTimeOffset? ts) =>
        ts?.LocalDateTime.ToString("yyyy-MM-dd HH:mm") ?? "Never";

    private static string FormatNextRun(DateTimeOffset? ts) =>
        ts?.LocalDateTime.ToString("yyyy-MM-dd HH:mm") ?? "\u2014";
}
